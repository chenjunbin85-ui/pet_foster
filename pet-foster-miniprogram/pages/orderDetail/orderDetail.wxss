/* 订单详情 */
.detail-page { padding: 40rpx 36rpx 220rpx;
  padding-top: 48rpx; }

/* 状态卡：左侧彩条 + 浅底 */
.status-card {
  border: 1rpx solid var(--pf-border, #F0E6DE);
  border-radius: 40rpx;
  padding: 34rpx 38rpx;
  margin-bottom: 26rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, var(--pf-brand-soft, #FFF0E8) 100%);
  box-shadow: 0 6rpx 24rpx rgba(201, 107, 61, 0.08);
}
.status-row { display: flex; align-items: center; gap: 14rpx; }
.status-text {
  font-size: 26rpx;
  color: var(--pf-ink-3, #7A7269);
  line-height: 1.8;
  margin-top: 18rpx;
}

.order-no {
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.4rpx;
}
.fee-stay-row { margin-top: 26rpx; }

.store-panel { margin-bottom: 34rpx; }
.timeline { padding: 6rpx 0 0; }
.tl-item {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding: 0 0 30rpx 0;
}
.tl-item::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: var(--pf-border, #F0E6DE);
}
.tl-item:last-child::before { display: none; }
.tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--pf-border, #F0E6DE);
  flex-shrink: 0;
  margin-top: 6rpx;
}
.tl-item.done .tl-dot { background: var(--pf-success, #2E7D32); }
.tl-item.current .tl-dot { background: var(--pf-brand, #FF6B35); box-shadow: 0 0 0 6rpx var(--pf-brand-soft, #FFF0E8); }
.tl-label { font-size: 28rpx; font-weight: 600; color: var(--pf-ink, #1E1B18); }
.tl-item.current .tl-label { color: var(--pf-brand, #FF6B35); }
.tl-item:not(.done):not(.current) .tl-label { color: var(--pf-ink-4, #A8A096); }
.tl-desc { font-size: 23rpx; color: var(--pf-ink-4, #A8A096); margin-top: 4rpx; }

.care-item { display: flex; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--pf-border, #F0E6DE); }
.care-item:last-child { border-bottom: none; }
.care-day { flex-shrink: 0; font-size: 22rpx; color: var(--pf-brand, #FF6B35); font-weight: 600; min-width: 72rpx; }
.care-type { font-size: 25rpx; color: var(--pf-ink, #1E1B18); font-weight: 600; }
.care-content { font-size: 24rpx; color: var(--pf-ink-3, #7A7269); margin-top: 4rpx; line-height: 1.6; }

.review-shown .review-stars { color: var(--pf-warning, #E65100); font-size: 30rpx; }
.review-shown .review-content { font-size: 26rpx; color: var(--pf-ink-2, #4A443E); margin-top: 10rpx; line-height: 1.7; }
.review-empty { text-align: center; padding: 20rpx 0; }
.review-empty text { font-size: 26rpx; color: var(--pf-ink-3, #7A7269); display: block; margin-bottom: 24rpx; }
.btn-sm { height: 80rpx; font-size: 26rpx; border-radius: 28rpx; padding: 0 40rpx; width: auto; display: inline-block; }
.rating-row { display: flex; justify-content: center; gap: 16rpx; margin-bottom: 28rpx; }
.star { font-size: 56rpx; color: #d1d5db; }
.star.on { color: var(--pf-warning, #E65100); }
.review-textarea { width: 100%; min-height: 160rpx; background: var(--pf-surface-low, #FAF2EC); border-radius: 20rpx; padding: 20rpx; font-size: 26rpx; box-sizing: border-box; margin-bottom: 28rpx; }
.store-note {
  font-size: 23rpx;
  color: var(--pf-ink-4, #A8A096);
  line-height: 1.9;
  margin-top: 28rpx;
}

.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--pf-border, #F0E6DE);
  padding: 16rpx 36rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 50;
}
.detail-actions .btn { flex: 1; }
