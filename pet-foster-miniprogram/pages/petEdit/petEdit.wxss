/* 宠物档案编辑 */
.edit-page { padding: 40rpx 36rpx 260rpx;
  padding-top: 48rpx; }

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}
.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--pf-brand-soft, #FFF0E8);
  border: 4rpx solid var(--pf-border, #F0E6DE);
}
.avatar-hint {
  font-size: 24rpx;
  color: var(--pf-ink-3, #7A7269);
  margin-top: 16rpx;
}

.lock-tip {
  background: var(--pf-brand-soft, #FFF0E8);
  border: 1rpx solid #ffe3d3;
  color: var(--pf-warning, #E65100);
  border-radius: 24rpx;
  font-size: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 26rpx;
  line-height: 1.7;
}

.form-panel { padding: 32rpx 38rpx; }
.form-row { padding: 22rpx 0; }
.form-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 29rpx;
  text-align: right;
  color: var(--pf-ink, #1E1B18);
  background: transparent;
  padding: 0;
}
.picker-value {
  font-size: 29rpx;
  color: var(--pf-ink, #1E1B18);
  text-align: right;
  min-height: 76rpx;
  line-height: 76rpx;
}
.picker-value.disabled { color: var(--pf-ink-4, #A8A096); }
.picker-value.readonly { color: var(--pf-ink, #1E1B18); font-weight: 600; }
.picker-value.has-proof { color: var(--pf-success, #2E7D32); }
.picker-chev {
  color: var(--pf-ink-4, #A8A096);
  margin-left: 10rpx;
  font-size: 26rpx;
}

/* 疫苗开关 */
.vaccine-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 6rpx 0 14rpx;
}
.vaccine-title { flex: 1; min-width: 0; }
.vaccine-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pf-ink, #1E1B18);
}
.vaccine-sub {
  font-size: 24rpx;
  color: var(--pf-ink-4, #A8A096);
  margin-top: 6rpx;
  line-height: 1.6;
}
.switch {
  width: 92rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #e5e6eb;
  position: relative;
  transition: background 0.2s;
  flex-shrink: 0;
}
.switch.on { background: var(--pf-brand, #FF6B35); }
.switch-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFFFF;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.2s;
}
.switch.on .switch-dot { left: 44rpx; }

.delete-btn { margin-top: 10rpx; }

/* 头像上传：上传中提示与移除入口 */
.avatar-remove {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--pf-ink-4, #A8A096);
  text-decoration: underline;
}
/* 疫苗证明缩略图 */
.proof-cell { display: flex; align-items: center; gap: 16rpx; }
.proof-thumb {
  width: 72rpx; height: 72rpx; border-radius: 12rpx;
  border: 2rpx solid var(--pf-border, #F0E6DE);
}
