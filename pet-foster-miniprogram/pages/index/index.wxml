<view class="page home-page">
  <!-- 顶部：店名 + 营业状态 -->
  <view class="home-head">
    <view class="home-brand">
      <text class="brand-kicker">WARM PETCARE OS</text>
      <view class="brand-line">
        <text class="brand-name">毛球旅馆</text>
        <text class="store-badge">旗舰店</text>
      </view>
    </view>
    <view class="store-open">
      <view class="dot"></view>
      <text>营业中 09:00–21:00</text>
    </view>
  </view>

  <!-- 分区标题：寄养爱宠 -->
  <view class="section-head">
    <text class="section-head-title">寄养爱宠</text>
    <text class="section-head-aside" bindtap="openPetPicker">管理爱宠 ›</text>
  </view>

  <!-- 预订信息卡 -->
  <view class="booking-panel">
    <view class="pet-row" bindtap="openPetPicker">
      <image class="home-pet-avatar" src="/images/pet-{{pet && pet.breed && pet.breed.indexOf('猫') > -1 ? 'cat' : 'dog'}}.png" mode="aspectFit" />
      <view class="pet-row-name">{{pet ? pet.name + '（' + (pet.breed || '未知品种') + '）' : '请选择或新增宠物'}}</view>
      <image class="chev-icon" src="/images/icon-chevron-gray.png" mode="aspectFit" />
    </view>

    <view class="date-fields">
      <picker class="date-picker" mode="date" value="{{start}}" start="{{today}}" end="{{maxStart}}" bindchange="onStartChange">
        <view class="date-cell">
          <view class="date-label">入住日期</view>
          <view class="date-value">{{startShort}}</view>
          <view class="date-tip">10:00</view>
        </view>
      </picker>
      <view class="duration-chip">共{{stayLabel}}</view>
      <picker class="date-picker" mode="date" value="{{end}}" start="{{start}}" end="{{maxEnd}}" bindchange="onEndChange">
        <view class="date-cell">
          <view class="date-label">离店日期</view>
          <view class="date-value">{{endShort}}</view>
          <view class="date-tip">18:00</view>
        </view>
      </picker>
    </view>

    <view class="billing-note error" wx:if="{{bookingReason}}">{{bookingReason}}</view>

    <view class="home-promise">
      <text>✓</text>
      <text>免费取消保护 · 入住前 24 小时可退</text>
    </view>
  </view>

  <!-- 热门房型：三列卡 -->
  <view class="room-section">
    <view class="section-head">
      <text class="section-head-title">热门房型</text>
      <text class="section-head-aside">实时房态</text>
    </view>
    <view class="room-grid">
      <view
        wx:for="{{prices}}"
        wx:key="id"
        class="room-card {{priceId === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPrice"
      >
        <view class="radio-dot room-radio {{priceId === item.id ? 'checked' : ''}}">
          <text wx:if="{{priceId === item.id}}" class="check-mark">✓</text>
        </view>
        <view wx:if="{{index == 1}}" class="room-popular">最受欢迎</view>
        <image class="room-icon" src="/images/room-{{index}}{{priceId === item.id ? '-active' : ''}}.png" mode="aspectFit" />
        <view class="room-name">{{item.levelName}}</view>
        <view class="room-desc">{{index == 0 ? '独立小屋 · 小型犬' : (index == 1 ? '加氧新风 · 阳光房' : '全景平层 · 私庭院')}}</view>
        <view class="room-price"><text class="yuan">¥</text>{{item.pricePerDay}}<text class="per">/晚</text></view>
      </view>
    </view>

    <view class="room-feature-row">
      <text>24h 实时直播</text>
      <text>24℃ 恒温新风</text>
      <text>每日驻店体检</text>
    </view>
  </view>

  <!-- 特殊照护备注 -->
  <view class="room-section">
    <view class="section-head"><text class="section-head-title">特殊照护需求（选填）</text></view>
    <view class="care-card">
      <textarea
        class="extras-textarea"
        placeholder="如：饮食习惯、需按时喂药、怕生等"
        placeholder-class="placeholder"
        maxlength="200"
        value="{{remark}}"
        bindinput="onRemarkInput"
      ></textarea>
    </view>
  </view>

  <!-- 底部动作栏：金额整行 + 双按钮（贴底，悬浮在 tabbar 上方） -->
  <view class="action-bar hotel-actions">
    <view class="action-summary">
      <text class="action-label">预估金额 · {{stayLabel}}</text>
      <text class="action-fee">¥{{totalFee}}</text>
    </view>
    <view class="hotel-action-buttons">
      <button class="btn btn-primary" hover-class="btn-hover" bindtap="bookNow">立即预订</button>
      <button class="btn btn-secondary" hover-class="btn-hover" bindtap="addPet">新增宠物</button>
    </view>
  </view>

  <!-- 宠物选择弹窗（居中） -->
  <view class="modal-mask" wx:if="{{showPetPicker}}" catchtap="closePetPicker">
    <view class="modal pet-modal" catchtap="noop">
      <view class="modal-close" catchtap="closePetPicker">
        <image class="close-icon" src="/images/icon-close-gray.png" mode="aspectFit" />
      </view>
      <image class="modal-pet-peak" src="/images/pet-illustration.png" mode="aspectFit" />
      <view class="modal-title">选择入住宠物</view>
      <view class="pet-picker-list">
        <view
          wx:for="{{pets}}"
          wx:key="id"
          class="pet-picker-option {{petId === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectPet"
        >
          <image class="pet-avatar-img" src="/images/pet-{{item.breed && item.breed.indexOf('猫') > -1 ? 'cat' : 'dog'}}.png" mode="aspectFit" />
          <view class="pet-picker-info">
            <view class="pet-picker-name">{{item.name}}</view>
            <view class="pet-picker-meta">{{item.breed || '未知品种'}} · {{item.gender || '—'}} · {{item.age || '—'}}岁 · {{item.weight || '—'}}kg</view>
            <text class="badge {{item.v ? 'badge-green' : 'badge-gray'}}">{{item.v ? '已免疫' : '未免疫'}}</text>
          </view>
          <view class="radio-dot {{petId === item.id ? 'checked' : ''}}">
            <text wx:if="{{petId === item.id}}" class="check-mark">✓</text>
          </view>
        </view>
        <view wx:if="{{!pets.length}}" class="pet-picker-empty">还没有宠物档案，请先新增</view>
      </view>
      <button class="btn btn-primary modal-confirm" hover-class="btn-hover" catchtap="closePetPicker">完成选择</button>
    </view>
  </view>
</view>
<tabbar id="tabbar" mode="client" selected="{{0}}" />
