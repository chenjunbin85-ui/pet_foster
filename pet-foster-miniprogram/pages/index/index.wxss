/* 首页 · 现代简约（375px 基准 → 1px = 2rpx）
   底色 #f5f1eb / 卡片 #ffffff 12px / 主字 #1a1a1a / 次字 #999 / 强调 #e8743b */
.home-page {
  padding: 34rpx 32rpx 340rpx;
  padding-top: 176rpx;
}

/* 顶部品牌区：店名 + 营业状态 */
.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.home-brand {
  display: flex;
  align-items: center;
  min-width: 0;
}
.brand-name {
  font-size: 52rpx;      /* 26px，与历史订单页标题同字号 */
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  color: #1A1A1A;
  white-space: nowrap;
}
.store-open {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;      /* 11px */
  color: #6EA782;
  flex-shrink: 0;
}
.store-open .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6EA782;
}

/* 预订信息卡 */
.booking-panel {
  background: #FFFFFF;
  border-radius: 24rpx;  /* 12px */
  padding: 0 28rpx 24rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.pet-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.hotel-field-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #999999;
  font-size: 24rpx;      /* 12px */
  flex-shrink: 0;
}
.paw-icon { width: 28rpx; height: 28rpx; opacity: 0.85; }
.pet-row-name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 500;
  color: #1A1A1A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.chev-icon { width: 26rpx; height: 26rpx; opacity: 0.4; }

/* 日期：入住 / 共N晚 / 离店 */
.date-fields {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 0;
}
.date-picker { flex: 1; min-width: 0; }
.date-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 140rpx;
}
.date-label {
  font-size: 22rpx;      /* 11px */
  color: #999999;
}
.date-value {
  font-size: 48rpx;      /* 24px */
  font-weight: 700;
  font-family: -apple-system, "Helvetica Neue", Arial, sans-serif;
  color: #1A1A1A;
  margin-top: 12rpx;
  letter-spacing: 0.5rpx;
}
.date-tip {
  font-size: 20rpx;      /* 10px */
  color: #AAAAAA;
  margin-top: 8rpx;
}
.duration-chip {
  min-width: 112rpx;
  padding: 10rpx 14rpx;
  border: 1rpx dashed #E8743B;
  border-radius: 14rpx;
  color: #E8743B;
  font-size: 22rpx;
  text-align: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.billing-note {
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.8;
  text-align: center;
  color: #D9534F;
}

/* 房型三列卡 */
.room-section { margin-bottom: 36rpx; }
.room-section .section-head { margin-bottom: 22rpx; }
.section-head-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
  color: #1A1A1A;
}
.room-grid {
  display: flex;
  gap: 16rpx;
}
.room-card {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 40rpx 12rpx 26rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.room-card.selected {
  border: 2rpx solid #E8743B;
  padding: 39rpx 11rpx 25rpx;
  background: #FFFAF5;
  box-shadow: 0 4rpx 16rpx rgba(232, 116, 59, 0.12);
}
.room-radio {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 26rpx;
  height: 26rpx;
  border-width: 1rpx;
  border-color: #CFC8BE;
}
.check-mark { font-size: 16rpx; line-height: 1; color: #FFFFFF; }
.room-icon {
  width: 56rpx;
  height: 52rpx;
  margin-bottom: 14rpx;
}
.room-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.room-price {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2rpx;
  color: #1A1A1A;
  font-size: 44rpx;
  font-weight: 700;
  font-family: Arial, sans-serif;
  margin-top: 12rpx;
  line-height: 1.2;
}
.room-price .yuan { font-size: 22rpx; font-weight: 500; }
.room-price .per { font-size: 20rpx; font-weight: 400; color: #AAAAAA; }

/* 增值服务 / 备注 */
.extras-section { margin-top: -4rpx; }
.extras-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.extra-chip {
  padding: 14rpx 28rpx;
  border: 1rpx solid #ECE7E0;
  border-radius: 32rpx;
  color: #666666;
  font-size: 24rpx;
  background: #FFFFFF;
}
.extra-chip.on {
  border-color: #E8743B;
  color: #E8743B;
  background: #FFF6EF;
}
.extras-textarea {
  width: 100%;
  min-height: 132rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.placeholder { color: #BBBBBB; }

/* 底部动作栏 */
.hotel-actions { display: block; }
.action-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.action-label {
  font-size: 22rpx;
  color: #999999;
}
.action-fee {
  font-size: 50rpx;
  font-weight: 700;
  font-family: Arial, sans-serif;
  color: #E8743B;
  letter-spacing: 0.5rpx;
}
.hotel-action-buttons {
  display: flex;
  gap: 20rpx;
}
.hotel-action-buttons .btn { flex: 1; }

/* 宠物选择弹窗 */
.pet-modal { position: relative; padding: 56rpx 40rpx 48rpx; }
.modal-close {
  position: absolute;
  right: 30rpx;
  top: 26rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.close-icon { width: 34rpx; height: 34rpx; opacity: 0.6; }
.modal-pet-peak {
  width: 168rpx;
  height: 168rpx;
  margin: -40rpx auto 6rpx;
  display: block;
}
.modal-title {
  font-size: 38rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 34rpx;
  color: #1A1A1A;
}
.pet-picker-list { display: flex; flex-direction: column; gap: 20rpx; }
.pet-picker-option {
  display: flex;
  align-items: center;
  gap: 22rpx;
  border: 1rpx solid #ECE7E0;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  text-align: left;
}
.pet-picker-option.selected {
  border: 2rpx solid #E8743B;
  padding: 27rpx 23rpx;
}
.pet-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FEF3E8;
  flex-shrink: 0;
}
.pet-picker-info { flex: 1; min-width: 0; }
.pet-picker-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.pet-picker-meta {
  font-size: 22rpx;
  color: #999999;
  margin: 6rpx 0 12rpx;
}
.badge-green, .badge-gray { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 14rpx; }
.pet-picker-option .radio-dot {
  width: 40rpx;
  height: 40rpx;
}
.pet-picker-empty {
  padding: 40rpx 0;
  text-align: center;
  color: #AAAAAA;
  font-size: 26rpx;
}
.modal-confirm { margin-top: 34rpx; }
