ider"></view><view class="photo-label">服务凭证照片</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p1.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p1" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p1" data-index="{{index}}">×</text></view><view class="photo photo-add" bindtap="choosePhoto" data-key="p1"><text class="ico">▣</text><text>拍照 / 上传</text></view></view><view class="hint">支持上传与预览服务凭证照片</view></view></view><view class="success show" wx:if="{{success}}"><view class="success-icon"></view><view >遛宠服务核销成功</view><view >核销后自动写入服务记录，对应待办任务自动消失。</view><button class="btn btn-outline" bindtap="toastMsg" data-msg="请从工作台选择对应订单后操作">返回工作台</button><view class="home-indicator"><text ></text></view></view></view><view class="footer" wx:if="{{!success}}"><button class="btn btn-primary" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">确认核销（仅遛宠）</button><view class="safe-area"><text ></text></view></view></view>