<view class="staff-page"><view class="content"><view class="card"><view class="row gap10"><view class="avatar lg a3">{{meInitial}}</view><view class="grow"><view class="row gap8"><text class="t15 strong">{{meName}}</text><text class="tag tag-green">在岗</text></view><view class="t11 muted mt4">{{positionLabel}}</view></view><view class="t11 muted right">11月6日 周五</view></view></view><view class="hero-card"><view class="hero-title">今日洗护任务</view><view class="hero-num">{{today.groom.total}} <text class="hero-unit">单</text></view><view class="hero-stats"><view><text class="hero-b">{{today.groom.total}}</text><text>待开始</text></view><view><text class="hero-b">{{today.groom.doing}}</text><text>作业中</text></view><view><text class="hero-b">{{today.groom.done}}</text><text>已完成</text></view></view></view><view class="section-head"><text class="section-title">今日洗护任务</text><text class="section-extra">按预约时间排序</text></view><view class="task" wx:for="{{today.groom.tasks}}" wx:key="id"><view class="task-head"><view class="avatar a3">{{item.petName}}</view><view class="grow"><view class="row between"><text class="task-name">{{item.petName}}</text><text class="tag tag-orange">{{item.taskStatus}}</text></view><text class="task-meta">{{item.breed}} · {{item.roomNo}} · {{item.bookTime}}</text></view></view><view class="task-foot"><text class="task-time">{{item.serviceName}}</text><button class="btn btn-primary btn-sm" bindtap="go" data-path="/pages/staff/g2/g2" data-id="{{item.id}}">开始作业</button></view></view><view class="empty" wx:if="{{!today.groom.tasks.length}}">今日暂无洗护任务</view></view></view>