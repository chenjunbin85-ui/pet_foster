/* 岗位队列：一级·岗位台，复用 styles/staff.wxss 令牌 */
.staff-page .role-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 4rpx 20rpx;
}
.staff-page .role-desc { font-size: 24rpx; color: var(--sub); }

.staff-page .progress-row { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.staff-page .progress-cell {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 12rpx;
  text-align: center;
}
.staff-page .progress-num { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.staff-page .progress-num.warn { color: var(--orange); }
.staff-page .progress-label { font-size: 22rpx; color: var(--sub); margin-top: 8rpx; }

.staff-page .red-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.staff-page .red-item {
  width: calc(50% - 8rpx);
  background: var(--warn-soft);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.staff-page .red-num { display: block; font-size: 40rpx; font-weight: 700; color: #A9581F; }
.staff-page .red-label { display: block; font-size: 22rpx; color: var(--sub); margin-top: 6rpx; }

.staff-page .queue-line { font-size: 22rpx; color: var(--sub); padding: 16rpx 0 4rpx; }
.staff-page .task-foot { justify-content: space-between; }
.staff-page .task-foot .btn { width: auto; flex: none; margin: 0; }

.staff-page .state-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin: 32rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.staff-page .state-title { font-size: 30rpx; font-weight: 600; }
.staff-page .state-copy { font-size: 22rpx; color: var(--sub); margin-top: 12rpx; line-height: 1.6; }
.staff-page .foot-note { font-size: 20rpx; color: var(--sub); text-align: center; padding: 24rpx 0 8rpx; }
