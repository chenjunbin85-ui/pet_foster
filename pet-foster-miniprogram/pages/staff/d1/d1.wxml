<view class="staff-page"><view class="content"><view class="card"><view class="row gap10"><view class="avatar lg a2">{{meInitial}}</view><view class="grow"><view class="row gap8"><text class="t15 strong">{{meName}}</text><text class="tag tag-blue">在岗</text></view><view class="t11 muted mt4">{{positionLabel}}</view></view></view></view><view class="hero-card"><view class="hero-title">今日接送</view><view class="hero-num">{{today.driver.total}} <text class="hero-unit">趟</text></view><view class="hero-stats"><view><text class="hero-b">{{today.driver.pending}}</text><text>待执行</text></view><view><text class="hero-b">{{today.driver.doing}}</text><text>进行中</text></view><view><text class="hero-b">{{today.driver.done}}</text><text>已完成</text></view></view></view><view class="section-head"><text class="section-title">路线概览</text><text class="section-extra">共 {{today.driver.total}} 趟</text></view><view class="card"><view class="map-box"><text class="map-label">今日路线</text><text class="map-tag">{{today.driver.tasks.length}} 个停靠点</text></view><view class="kv mt8"><text class="k">下一趟接送目的地</text><text class="v orange strong">{{today.driver.tasks[0].address || '—'}}</text></view><view class="kv"><text class="k">下一趟预约时间</text><text class="v">{{today.driver.tasks[0].bookTime || '—'}} · {{today.driver.tasks[0].pickupType || '接送'}}</text></view></view><view class="section-head"><text class="section-title">接送任务时间线</text><text class="section-extra">按预约时间排序</text></view><view class="timeline"><view class="tl-item" wx:for="{{today.driver.tasks}}" wx:key="id"><view class="tl-dot"></view><view class="tl-card"><view class="row between"><text class="tag tag-orange">{{item.pickupType}} · {{item.bookTime}}</text><text class="tag tag-gray">{{item.taskStatus}}</text></view><view class="row gap8 mt10"><view class="avatar sm a2">{{item.petName}}</view><view class="grow"><text class="t13 strong">{{item.petName}}</text><text class="t11 muted"> · 客户 {{item.customerName}}</text></view></view><view class="t11 muted mt8">⌖ {{item.address}}</view><view class="task-foot"><text class="t11 muted">{{item.phoneMasked}}</text><button class="btn btn-primary btn-sm" bindtap="go" data-path="/pages/staff/d2/d2" data-id="{{item.id}}">到场打卡</button></view></view></view><view class="empty" wx:if="{{!today.driver.tasks.length}}">今日暂无接送任务</view></view></view></view>