<view class="staff-page has-foot"><view class="content"><include src="/templates/subject.wxml" /><view class="card"><view class="kv"><text class="k">订单编号</text><text class="v">{{d.orderNo}}</text></view><view class="kv"><text class="k">评估状态</text><text class="v"><text class="tag tag-orange">待评估</text></text></view></view><view class="card"><view class="card-head"><text class="card-title">宠物档案摘要</text><text class="tag tag-blue">入店前</text></view><view class="row gap10"><view class="avatar lg a3">糯</view><view class="grow"><view class="t15 strong">{{d.petName}}</view><view class="t12 muted mt4">布偶猫 · 2 岁 · 4.2 kg</view></view></view><view class="divider"></view><view class="kv"><text class="k">疫苗接种记录</text><text class="v">猫三联 · 2026-03-18</text></view><view class="kv"><text class="k">既往病史</text><text class="v">无</text></view><view class="kv"><text class="k">过敏信息</text><text class="v">无已知过敏</text></view><view class="divider"></view><view class="photo-label">疫苗证明照片</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p1.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p1" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p1" data-index="{{index}}">×</text></view></view></view><view class="card"><view class="card-head"><text class="card-title">健康评估表单</text></view><view class="form-row"><view class="form-label req">体温</view><view class="form-field"><view class="inline-input"><input class="input" type="digit" value="{{form.temperature}}" bindinput="onField" data-field="temperature" /><text class="unit">℃</text></view></view></view><view class="form-row"><view class="form-label req">体表检查</view><view class="form-field"><input class="input" type="text" value="{{form.skinExam}}" bindinput="onField" data-field="skinExam" /></view></view><view class="form-row"><view class="form-label req">精神状态</view><view class="form-field"><view class="choice-group"><view class="choice {{form.v2spirit==='正常'?'on':''}}" bindtap="pick" data-field="v2spirit" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.v2spirit==='异常'?'on':''}}" bindtap="pick" data-field="v2spirit" data-value="异常" data-clear-alert="1"><text >异常</text></view></view></view></view><view class="form-row"><view class="form-label req">传染病筛查结论</view><view class="form-field"><view class="choice-group"><view class="choice {{form.screen==='通过'?'on':''}}" bindtap="pick" data-field="screen" data-value="通过" data-clear-alert="1"><text >通过</text></view><view class="choice {{form.screen==='隔离观察'?'on':''}}" bindtap="pick" data-field="screen" data-value="隔离观察" data-clear-alert="1"><text >隔离观察</text></view></view></view></view><view class="form-row"><view class="form-label">评估说明</view><view class="form-field"><textarea class="textarea" value="{{form.note}}" placeholder="填写本次入店评估说明" bindinput="onField" data-field="note"></textarea></view></view></view><view class="section-head"><text class="section-title">兽医评估签署</text><text class="req-mark">有效签署后生成入店许可</text></view><view class="card"><view class="kv"><text class="k">执业证号</text><text class="v ro">A3505****0218（自动带出）</text></view><view class="kv"><text class="k">签署兽医</text><text class="v">{{meName}}</text></view><view class="kv"><text class="k">签署时间</text><text class="v ro">提交时自动记录</text></view><view class="divider"></view><view class="sign-wrap"><view class="sign-pad"><canvas canvas-id="sign1" class="sign-canvas" bindtouchstart="signStart" bindtouchmove="signMove" bindtouchend="signEnd" data-id="sign1"></canvas><text class="sign-ph" wx:if="{{!form.signed}}">请兽医手写签名</text></view><view class="sign-actions"><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">清除</button><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">重新签署</button></view></view></view></view><view class="footer"><view class="btn-stack"><button class="btn btn-red-outline" bindtap="toastMsg" data-msg="演示环境：请从工作台进入对应业务">转隔离</button><button class="btn btn-primary" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">签署允许入店</button></view><view class="footer-hint">转隔离为独立业务操作，不生成入店许可</view></view></view>