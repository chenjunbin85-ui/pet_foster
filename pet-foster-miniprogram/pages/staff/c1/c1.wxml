<view class="staff-page"><view class="topbar"><view class="statusbar"><text>9:41</text><view class="sb-right"><text class="ico">▂▄▆</text><text class="ico">◔</text><text class="ico">▭</text></view></view><view class="navbar"><view class="nav-back" bindtap="goBack"><text class="ico">‹</text></view><text class="nav-title">{{title}}</text><view class="nav-capsule"><text class="ico">···</text><text class="ico">◎</text></view></view></view><view class="content"><view class="data-strip" wx:if="{{d.orderNo}}">订单 {{d.orderNo}} · {{d.petName}} · {{d.roomNo}} · {{d.status}}</view><view class="card"><view class="row gap10"><view class="avatar lg a1">林</view><view class="grow"><view class="row gap8"><text class="t15 strong">林晓雯</text><text class="tag tag-green">在岗</text></view><view class="t11 muted mt4">护理员 · 寄养部 A 区</view></view><view class="t11 muted right">{{today.dateText}} 周五</view></view><view class="divider"></view><view class="t12 muted mb8">当前班次</view><view class="segment"><view class="segment-item {{tab.shift==='morning'?'active':''}}" bindtap="switchTab" data-group="shift" data-tab="morning">早班</view><view class="segment-item {{tab.shift==='middle'?'active':''}}" bindtap="switchTab" data-group="shift" data-tab="middle">中班</view><view class="segment-item {{tab.shift==='night'?'active':''}}" bindtap="switchTab" data-group="shift" data-tab="night">晚班</view></view></view><view class="card"><view class="card-head"><text class="card-title">今日巡视进度</text><text class="tag tag-orange">中班</text></view><view class="row gap12"><view class="ring"><view class="ring-track"></view><view class="ring-center"><text class="bold">{{today.patrol.done}}/{{today.patrol.total}} 次</text><text>已完成巡视</text></view></view><view class="grow"><view class="t11 muted">当日日期</view><view class="t14 strong mt4">{{today.date}} · {{today.weekday}}</view><view class="t11 muted mt12">班次时间</view><view class="t14 strong mt4">{{today.shiftTime}}</view><view class="t11 orange mt12">下次巡视 {{today.nextPatrol}}</view></view></view><view class="mini-counts"><view class="mini-count"><text class="green">1 次</text><text >已完成</text></view><view class="mini-count"><text class="orange">2 次</text><text >待完成</text></view></view></view><view class="section-head"><text class="section-title">今日护理任务</text><text class="section-extra">共 6 项 · 按时间排序</text></view><view class="task" wx:for="{{today.orders}}" wx:key="id"><view class="task-head"><view class="avatar a1">{{item.petName}}</view><view class="grow"><view class="row between"><text class="task-name">{{item.petName}}</text><text class="tag {{item.status==='寄养中'?'tag-orange':'tag-green'}}">{{item.status}}</text></view><text class="task-meta">{{item.breed}} · {{item.roomNo}} · {{item.startDate}} ~ {{item.endDate}}</text></view></view><view class="task-foot"><text class="task-time">{{today.shift}}班 · 巡视 / 喂养 / 清洁</text><view class="row gap6"><button class="btn btn-outline btn-sm" bindtap="go" data-path="/pages/staff/c3/c3" data-id="{{item.id}}">护理记录</button><button class="btn btn-primary btn-sm" bindtap="go" data-path="/pages/staff/c2/c2" data-id="{{item.id}}">开始巡视</button></view></view></view><view class="empty" wx:if="{{!today.orders.length}}">今日暂无待办订单</view><view class="notice notice-danger mt16" style="align-items:center"><text class="ico">!</text><view class="grow"><view class="notice-title">发现异常？及时上报</view><view class="t11" style="opacity:.85">异常由护理员记录，定级处置由兽医完成</view></view><button class="btn btn-red-outline btn-sm nowrap" bindtap="go" data-path="/pages/staff/c4/c4">异常上报</button></view></view></view>