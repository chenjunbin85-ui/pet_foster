<view class="staff-page">
  <view class="content">

    

    <!-- 当班身份 -->
    <view class="hero">
      <view class="avatar lg a1">{{meInitial}}</view>
      <view class="grow">
        <view class="row gap8">
          <text class="hero-name">{{meName}}</text>
          <text class="tag {{readOnly ? 'tag-gray' : 'tag-green'}}">{{readOnly ? '只读' : '在岗'}}</text>
        </view>
        <view class="hero-meta">{{positionLabel}}</view>
      </view>
      <view class="hero-side">{{today.dateText}}<text wx:if="{{today.weekday}}"> {{today.weekday}}</text></view>
    </view>

    <!-- 当前班次 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">当前班次</text>
        <text class="card-sub">{{today.shiftTime}}</text>
      </view>
      <view class="segment">
        <view class="segment-item {{tab.shift==='morning'?'active':''}}" bindtap="switchSegment" data-group="shift" data-tab="morning">早班</view>
        <view class="segment-item {{tab.shift==='middle'?'active':''}}" bindtap="switchSegment" data-group="shift" data-tab="middle">中班</view>
        <view class="segment-item {{tab.shift==='night'?'active':''}}" bindtap="switchSegment" data-group="shift" data-tab="night">晚班</view>
      </view>
    </view>

    <!-- 巡视进度 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">今日巡视进度</text>
        <text class="tag tag-orange">{{today.shift}}班</text>
      </view>
      <view class="row between">
        <view>
          <view class="big-num">{{today.patrol.done}}<text class="big-unit">/{{today.patrol.total}} 次</text></view>
          <view class="t11 muted">已完成巡视</view>
        </view>
        <view class="right">
          <view class="t11 muted">下次巡视</view>
          <view class="t14 strong orange mt4">{{today.nextPatrol}}</view>
        </view>
      </view>
      <view class="meter">
        <view class="meter-fill" style="width:{{today.patrol.total ? today.patrol.done / today.patrol.total * 100 : 0}}%"></view>
      </view>
      <view class="row between t11 muted">
        <text>{{today.date}} · {{today.weekday}}</text>
        <text>待完成 {{today.patrol.pending}} 次</text>
      </view>
    </view>

    <!-- 今日任务 -->
    <view class="section-head">
      <text class="section-title">今日护理任务</text>
      <text class="section-extra">按时间排序</text>
    </view>

    <view class="task" wx:for="{{today.orders}}" wx:key="id">
      <view class="task-head">
        <view class="avatar a1">{{item.petName}}</view>
        <view class="grow">
          <view class="row between">
            <text class="task-name">{{item.petName}}</text>
            <text class="tag {{item.status==='寄养中'?'tag-orange':'tag-green'}}">{{item.status}}</text>
          </view>
          <view class="task-meta">{{item.breed}} · {{item.roomNo}}</view>
          <view class="task-meta">{{item.startDate}} ~ {{item.endDate}}</view>
        </view>
      </view>
      <view class="task-foot">
        <text class="task-time">{{today.shift}}班 · 巡视 / 喂养 / 清洁</text>
        <view class="row gap6">
          <button class="btn btn-outline btn-sm" bindtap="go" data-path="/pages/staff/c3/c3" data-id="{{item.id}}">护理记录</button>
          <button class="btn btn-primary btn-sm" bindtap="go" data-path="/pages/staff/c2/c2" data-id="{{item.id}}">开始巡视</button>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!today.orders.length}}">今日暂无待办订单</view>

    <view class="notice notice-danger">
      <text class="ico">!</text>
      <view class="grow">
        <view class="notice-title">发现异常？及时上报</view>
        异常由护理员记录，定级与处置由兽医完成。
      </view>
      <button class="btn btn-red-outline btn-sm nowrap" bindtap="go" data-path="/pages/staff/c4/c4">异常上报</button>
    </view>
  </view>
</view>
