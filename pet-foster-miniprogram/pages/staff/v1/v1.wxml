<view class="staff-page"><view class="content"><view class="card"><view class="row gap10"><view class="avatar lg a6">{{meInitial}}</view><view class="grow"><view class="row gap8"><text class="t15 strong">{{meName}}</text><text class="tag {{readOnly ? 'tag-gray' : 'tag-green'}}">{{readOnly ? '只读' : '执业中'}}</text></view><view class="t11 muted mt4">{{positionLabel}}</view></view></view></view><view class="card"><view class="row between"><view ><view class="t14 strong">今日在岗确认</view><view class="t11 muted mt4">确认后方可执行评估与签署</view></view><switch class="switch" checked="{{form.onDuty||duty.onDuty}}" bindchange="toggleDuty" color="#16A34A" /></view><view class="divider"></view><view class="notice notice-success" style="margin:0" wx:if="{{form.onDuty||duty.onDuty}}"><text class="ico">✓</text><view ><view class="notice-title">今日已确认在岗</view>已完成在岗确认，可开展评估与签署</view></view><view class="notice notice-danger" style="margin:0" wx:if="{{!(form.onDuty||duty.onDuty)}}"><text class="ico">锁</text><view ><view class="notice-title">尚未确认今日在岗</view>在岗确认是全部业务操作的前置条件，下方待办已锁定</view></view></view><view class="duty-list {{form.onDuty||duty.onDuty?'':'off'}}"><view class="stat-grid"><view class="stat"><view class="stat-num">{{today.vet.pendingAssessment}}</view><view class="stat-label">待入店评估 / 单</view></view><view class="stat"><view class="stat-num red">{{today.vet.pendingReview}}</view><view class="stat-label">待复核异常 / 个</view></view><view class="stat"><view class="stat-num">{{today.vet.pendingCheckout}}</view><view class="stat-label">待离店评估 / 单</view></view></view><view class="section-head"><text class="section-title">今日待办</text><text class="section-extra">按紧急程度排序</text></view><view class="task alert" wx:for="{{today.vet.reviewTasks}}" wx:key="incidentId"><view class="task-head"><view class="avatar a5">{{item.petName}}</view><view class="grow"><view class="row between"><text class="task-name">{{item.petName}}</text><text class="tag tag-red">待复核</text></view><text class="task-meta">{{item.orderId}} · {{item.category}} · {{item.roomNo}}</text></view></view><view class="task-foot"><text class="task-time">{{item.description}}</text><button class="btn btn-red-outline btn-sm" bindtap="go" data-path="/pages/staff/v3/v3" data-incident-id="{{item.incidentId}}">去复核</button></view></view><view class="task" wx:for="{{today.orders}}" wx:key="id"><view class="task-head"><view class="avatar a3">{{item.petName}}</view><view class="grow"><view class="row between"><text class="task-name">{{item.petName}}</text><text class="tag tag-orange">待签署</text></view><text class="task-meta">{{item.orderNo}} · {{item.breed}} · {{item.roomNo}}</text></view></view><view class="task-foot"><text class="task-time">{{item.status}} · 健康评估</text><view class="row gap6"><button class="btn btn-outline btn-sm" bindtap="go" data-path="/pages/staff/v2/v2" data-id="{{item.id}}">入店评估</button><button class="btn btn-primary btn-sm" bindtap="go" data-path="/pages/staff/v5/v5" data-id="{{item.id}}">离店评估</button></view></view></view><view class="empty" wx:if="{{!today.vet.reviewTasks.length && !today.orders.length}}">暂无待复核异常与评估任务</view></view></view></view>