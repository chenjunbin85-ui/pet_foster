<view class="staff-page has-foot"><view class="content"><include src="/templates/subject.wxml" /><view class="card"><view class="row gap10"><view class="avatar lg a6">麦</view><view class="grow"><view class="t15 strong">{{d.petName}}</view><view class="t12 muted mt4">比熊 · {{d.roomNo}}</view></view><text class="tag tag-blue">作业中</text></view><view class="divider"></view><view class="kv"><text class="k">订单编号</text><text class="v">{{d.orderNo}}</text></view><view class="kv"><text class="k">本次预约洗护项目</text><text class="v orange strong">美容</text></view></view><view class="card"><view class="card-head"><text class="card-title">作业前检查</text><text class="req-mark">必填</text></view><view class="form-row"><view class="form-label req">毛况</view><view class="form-field"><view class="choice-group"><view class="choice {{form.coat==='正常'?'on':''}}" bindtap="pick" data-field="coat" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.coat==='打结'?'on':''}}" bindtap="pick" data-field="coat" data-value="打结" data-clear-alert="1"><text >打结</text></view></view></view></view><view class="form-row"><view class="form-label req">皮肤检查</view><view class="form-field"><view class="choice-group"><view class="choice {{form.skin==='正常'?'on':''}}" bindtap="pick" data-field="skin" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.skin==='红肿'?'on':''}}" bindtap="pick" data-field="skin" data-value="红肿" data-alert="1"><text >红肿</text></view><view class="choice {{form.skin==='寄生虫'?'on':''}}" bindtap="pick" data-field="skin" data-value="寄生虫" data-alert="1"><text >寄生虫</text></view></view></view></view></view><view class="card"><view class="card-head"><text class="card-title">作业内容</text><text class="card-sub">本次洗护</text></view><textarea class="textarea" value="{{form.f1}}" placeholder="填写本次洗护内容" bindinput="onField" data-field="f1"></textarea><view class="form-row mt8"><view class="form-label">用品记录</view><view class="form-field"><input class="input" type="text" value="{{form.supplies}}" bindinput="onField" data-field="supplies" /></view></view></view><view class="section-head"><text class="section-title">照片记录</text><text class="req-mark">作业前后各必留</text></view><view class="card"><view class="photo-label">作业前照片</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p1.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p1" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p1" data-index="{{index}}">×</text></view><view class="photo photo-add" bindtap="choosePhoto" data-key="p1"><text class="ico">▣</text><text>拍照 / 上传</text></view></view><view class="divider"></view><view class="photo-label">作业后照片</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p2.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p2" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p2" data-index="{{index}}">×</text></view><view class="photo photo-add" bindtap="choosePhoto" data-key="p2"><text class="ico">▣</text><text>拍照 / 上传</text></view></view><view class="hint">两个区域独立留存，支持上传、预览与删除</view></view><view class="notice notice-danger" wx:if="{{form.skinAlert}}"><text class="ico">!</text><view ><view class="notice-title">发现皮肤问题，请转交护理员 / 兽医</view>异常情况不允许走正常完成核销流程。</view></view></view><view class="footer"><button class="btn btn-primary" wx:if="{{!form.skinAlert}}" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">完成并核销</button><button class="btn btn-red" wx:if="{{form.skinAlert}}" bindtap="toastMsg" data-msg="演示环境：请从工作台进入对应业务">转交护理 / 兽医</button></view></view>