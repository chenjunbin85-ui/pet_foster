<view class="staff-page">
  <view class="content">

    <!-- 降级为二级页：不再承担身份、统计与待办，只保留入口 -->
    <view class="back-bar" bindtap="goToday">
      <text class="ico">‹</text><text>返回今日</text>
    </view>
    <view class="page-intro">
      <text class="intro-title">全部功能</text>
      <text class="intro-copy">按岗位授权 · 待办与进度请回「今日」查看</text>
    </view>

    <view class="notice notice-warn" wx:if="{{today.vet && !today.vet.vetReady && isVet}}">
      <text class="ico">!</text>
      <view class="grow">
        <view class="notice-title">今日尚未完成在岗确认</view>
        按合规要求，评估与签署操作已锁定，请先在兽医工作台确认在岗。
      </view>
    </view>

    <!-- 岗位工作台 -->
    <view class="section-head" wx:if="{{workbenches.length}}">
      <view class="section-title pf-marker">岗位工作台</view>
      <text class="section-extra">按岗位显示</text>
    </view>
    <view class="workbench-grid" wx:if="{{workbenches.length}}">
      <view class="workbench" wx:for="{{workbenches}}" wx:key="key" bindtap="go" data-path="{{item.path}}">
        <view class="avatar a2">{{item.shortLabel}}</view>
        <view class="grow">
          <view class="workbench-title">{{item.shortTitle}}</view>
          <view class="workbench-sub">进入工作台</view>
        </view>
        <text class="workbench-arrow">›</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <block wx:for="{{groups}}" wx:key="key">
      <view class="section-head">
        <view class="section-title pf-marker">{{item.label}}</view>
        <text class="section-extra">{{item.items.length}} 项</text>
      </view>
      <view class="card menu-list">
        <view class="menu-row" wx:for="{{item.items}}" wx:for-item="p" wx:key="key" bindtap="go" data-path="{{p.path}}">
          <text class="menu-label">{{p.title}}</text>
          <text class="tag tag-gray" wx:if="{{p.readOnly}}">只读</text>
          <text class="menu-chev">›</text>
        </view>
      </view>
    </block>

    <view class="foot-note">按岗位授权 · 每次操作均记录操作人与时间</view>
  </view>
</view>
