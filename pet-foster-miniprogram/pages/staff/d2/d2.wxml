<view class="staff-page"><view class="topbar"><view class="statusbar"><text>9:41</text><view class="sb-right"><text class="ico">▂▄▆</text><text class="ico">◔</text><text class="ico">▭</text></view></view><view class="navbar"><view class="nav-back" bindtap="goBack"><text class="ico">‹</text></view><text class="nav-title">{{title}}</text><view class="nav-capsule"><text class="ico">···</text><text class="ico">◎</text></view></view></view><view class="content"><view class="data-strip" wx:if="{{d.orderNo}}">订单 {{d.orderNo}} · {{d.petName}} · {{d.roomNo}} · {{d.status}}</view><view class="segment"><view class="segment-item {{tab.driver==='pickup'?'active':''}}" bindtap="switchTab" data-group="driver" data-tab="pickup">接宠</view><view class="segment-item {{tab.driver==='delivery'?'active':''}}" bindtap="switchTab" data-group="driver" data-tab="delivery">送回</view></view><view class="card"><view class="row between mb8"><text class="tag tag-orange">接宠</text><text class="t11 muted">2026-11-06 16:00</text></view><view class="kv"><text class="k">订单编号</text><text class="v">{{d.orderNo}}</text></view><view class="kv"><text class="k">客户信息</text><text class="v">{{d.customerName}} · {{d.phoneMasked}}</text></view><view class="kv"><text class="k">宠物信息</text><text class="v">{{d.petName}} · 布偶猫</text></view><view class="kv"><text class="k">预约时间</text><text class="v">2026-11-06 16:00</text></view><view class="kv"><text class="k">接送地址</text><text class="v">丰泽区东海大街 88 号</text></view></view><view class="section-head"><text class="section-title">定位信息</text><text class="tag tag-green">已定位</text></view><view class="card"><view class="map-box"><text class="map-label">当前定位</text><text class="map-tag">定位偏差 12 m</text></view><view class="kv mt8"><text class="k">当前定位状态</text><text class="v ok">已定位 · 丰泽区东海大街</text></view><view class="kv"><text class="k">到场时间</text><text class="v">2026-11-06 16:02</text></view></view><view class="section-head"><text class="section-title">宠物状态确认</text><text class="req-mark">必确认</text></view><view class="card"><view class="row gap10 mb12"><view class="avatar lg a2">糯</view><view class="grow"><view class="t14 strong">{{d.petName}}</view><view class="t11 muted mt4">当前外观：被毛整洁、精神良好</view></view></view><view class="choice-group mb12"><view class="choice {{form.petstate==='状态良好'?'on':''}}" bindtap="pick" data-field="petstate" data-value="状态良好" data-clear-alert="1"><text >状态良好</text></view><view class="choice {{form.petstate2==='需关注'?'on':''}}" bindtap="pick" data-field="petstate2" data-value="需关注" data-clear-alert="1"><text >需关注</text></view></view><textarea class="textarea" value="{{form.f1}}" placeholder="填写状态备注（选填）" bindinput="onField" data-field="f1"></textarea></view><view class="section-head"><text class="section-title">现场照片</text><text class="req-mark">必拍 2 类</text></view><view class="card"><view class="photo-label">宠物现场照片</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p1.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p1" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p1" data-index="{{index}}">×</text></view><view class="photo photo-add" bindtap="choosePhoto" data-key="p1"><text class="ico">▣</text><text>拍照 / 上传</text></view></view><view class="divider"></view><view class="photo-label">交接场景照片</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p2.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p2" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p2" data-index="{{index}}">×</text></view><view class="photo photo-add" bindtap="choosePhoto" data-key="p2"><text class="ico">▣</text><text>拍照 / 上传</text></view></view><view class="hint">照片自动附加时间与地点水印，支持拍照与预览</view></view><view wx:if="{{tab.driver==='pickup'}}"><view class="section-head"><text class="section-title">客户电子签字</text><text class="req-mark">必签 · 交接人</text></view><view class="card"><view class="kv"><text class="k">签署对象</text><text class="v">客户 {{d.customerName}}</text></view><view class="divider"></view><view class="sign-wrap"><view class="sign-pad"><canvas canvas-id="sign1" class="sign-canvas" bindtouchstart="signStart" bindtouchmove="signMove" bindtouchend="signEnd" data-id="sign1"></canvas><text class="sign-ph" wx:if="{{!form.signed}}">请客户手写签字确认交接</text></view><view class="sign-actions"><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">清除</button><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">重新签署</button></view></view></view></view><view wx:if="{{tab.driver==='delivery'}}"><view class="section-head"><text class="section-title">门店接收人签字</text><text class="req-mark">必签 · 交接人</text></view><view class="card"><view class="kv"><text class="k">签署对象</text><text class="v">门店接收人 林晓雯</text></view><view class="divider"></view><view class="sign-wrap"><view class="sign-pad"><canvas canvas-id="sign2" class="sign-canvas" bindtouchstart="signStart" bindtouchmove="signMove" bindtouchend="signEnd" data-id="sign2"></canvas><text class="sign-ph" wx:if="{{!form.signed}}">请门店接收人手写签字确认</text></view><view class="sign-actions"><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign2">清除</button><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign2">重新签署</button></view></view></view></view><view class="notice notice-info"><text class="ico">i</text><view >未完成定位、必拍照片与对应交接人签字，不允许完成交接。</view></view></view><view class="footer"><button class="btn btn-primary" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">确认交接</button><view class="safe-area"><text ></text></view></view></view>