<view class="staff-page"><view class="topbar"><view class="statusbar"><text>9:41</text><view class="sb-right"><text class="ico">▂▄▆</text><text class="ico">◔</text><text class="ico">▭</text></view></view><view class="navbar"><view class="nav-back" bindtap="goBack"><text class="ico">‹</text></view><text class="nav-title">{{title}}</text><view class="nav-capsule"><text class="ico">···</text><text class="ico">◎</text></view></view></view><view class="content"><view class="data-strip" wx:if="{{d.orderNo}}">订单 {{d.orderNo}} · {{d.petName}} · {{d.roomNo}} · {{d.status}}</view><view class="notice notice-danger"><text class="ico">!</text><view ><view class="notice-title">隔离 / 送医授权</view>    {{d.petName}} · 金毛 · {{d.roomNo}} 订单编号 {{d.orderNo}} 关联异常编号 AB202611060012  </view></view><view class="section-head"><text class="section-title">客户通知确认</text><text class="req-mark">授权前置条件</text></view><view class="card"><view class="check-row {{form.notified?'on':''}}" bindtap="toggle" data-field="notified"><text class="check-box"></text><text class="grow t13">已通知客户</text><text class="t11 orange strong">必勾</text></view><view wx:if="{{form.notified}}"><view class="divider"></view><view class="form-row"><view class="form-label req">通知渠道</view><view class="form-field"><view class="choice-group"><view class="choice {{form.channel==='电话'?'on':''}}" bindtap="pick" data-field="channel" data-value="电话" data-clear-alert="1"><text >电话</text></view><view class="choice {{form.channel2==='微信'?'on':''}}" bindtap="pick" data-field="channel2" data-value="微信" data-clear-alert="1"><text >微信</text></view></view></view></view><view class="form-row"><view class="form-label req">通知时间</view><view class="form-field"><input class="input" type="text" value="{{form.notifyTime}}" bindinput="onField" data-field="notifyTime" /><view class="hint">通知渠道与时间随授权一并保存</view></view></view></view><view class="notice notice-danger" style="margin:12px 0 0" wx:if="{{!form.notified}}"><text class="ico">锁</text><view >未确认客户通知，禁止提交授权</view></view></view><view class="section-head"><text class="section-title">授权信息</text><text class="section-extra">单选授权类型</text></view><view class="card"><view class="choice-grid"><view class="choice-card {{form.authtype==='隔离'?'on':''}}" bindtap="pick" data-field="authtype" data-value="隔离" data-clear-alert="1"><text >隔离</text></view><view class="choice-card {{form.authtype2==='送医'?'on':''}}" bindtap="pick" data-field="authtype2" data-value="送医" data-clear-alert="1"><text >送医</text></view></view><view class="divider"></view><view class="form-row"><view class="form-label">医院名称</view><view class="form-field"><input class="input" type="text" value="{{form.hospital}}" placeholder="填写送医医院名称" bindinput="onField" data-field="hospital" /></view></view><view class="form-row"><view class="form-label req">授权原因</view><view class="form-field"><textarea class="textarea" value="{{form.reason}}" placeholder="填写隔离或送医授权原因" bindinput="onField" data-field="reason"></textarea></view></view></view><view class="section-head"><text class="section-title">兽医签署</text><text class="req-mark">必签</text></view><view class="card"><view class="kv"><text class="k">执业证号</text><text class="v ro">A3505****0218（自动带出）</text></view><view class="kv"><text class="k">签署兽医</text><text class="v">陈昱</text></view><view class="kv"><text class="k">签署时间</text><text class="v ro">提交时自动记录</text></view><view class="divider"></view><view class="sign-wrap"><view class="sign-pad"><canvas canvas-id="sign1" class="sign-canvas" bindtouchstart="signStart" bindtouchmove="signMove" bindtouchend="signEnd" data-id="sign1"></canvas><text class="sign-ph" wx:if="{{!form.signed}}">请兽医手写授权签名</text></view><view class="sign-actions"><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">清除</button><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">重新签署</button></view></view></view></view><view class="footer"><button class="btn btn-red" bindtap="submit" disabled="{{readOnly||submitting||!form.notified}}" loading="{{submitting}}">确认授权</button><view class="safe-area"><text ></text></view></view></view>