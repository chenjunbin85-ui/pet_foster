<view class="staff-page has-foot"><view class="content"><include src="/templates/subject.wxml" /><view class="card"><view class="row gap10"><view class="avatar lg a2">糯</view><view class="grow"><view class="row between"><text class="t15 strong">{{d.petName}}</text><text class="tag tag-blue">寄养中</text></view><view class="t12 muted mt4">布偶猫 · {{d.roomNo}}</view><view class="mt8"><text class="tag tag-orange">第2次巡视 · 中班</text></view></view></view></view><view class="card"><view class="card-head"><text class="card-title">巡视数据</text><text class="card-sub">健康状态</text></view><view class="form-row"><view class="form-label req">体温</view><view class="form-field"><view class="inline-input"><input class="input" type="digit" value="{{form.temperature}}" bindinput="onField" data-field="temperature" /><text class="unit">℃</text></view></view></view><view class="form-row"><view class="form-label req">精神状态</view><view class="form-field"><view class="choice-group"><view class="choice {{form.spirit==='正常'?'on':''}}" bindtap="pick" data-field="spirit" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.spirit==='萎靡'?'on':''}}" bindtap="pick" data-field="spirit" data-value="萎靡" data-clear-alert="1"><text >萎靡</text></view><view class="choice {{form.spirit==='亢奋'?'on':''}}" bindtap="pick" data-field="spirit" data-value="亢奋" data-clear-alert="1"><text >亢奋</text></view></view></view></view><view class="form-row"><view class="form-label req">食欲情况</view><view class="form-field"><view class="choice-group"><view class="choice {{form.appetite==='正常'?'on':''}}" bindtap="pick" data-field="appetite" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.appetite==='少食'?'on':''}}" bindtap="pick" data-field="appetite" data-value="少食" data-clear-alert="1"><text >少食</text></view><view class="choice {{form.appetite==='拒食'?'on':''}}" bindtap="pick" data-field="appetite" data-value="拒食" data-clear-alert="1"><text >拒食</text></view></view></view></view><view class="form-row"><view class="form-label req">排便情况</view><view class="form-field"><view class="choice-group"><view class="choice {{form.stool==='正常'?'on':''}}" bindtap="pick" data-field="stool" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.stool==='腹泻'?'on':''}}" bindtap="pick" data-field="stool" data-value="腹泻" data-clear-alert="1"><text >腹泻</text></view><view class="choice {{form.stool==='便秘'?'on':''}}" bindtap="pick" data-field="stool" data-value="便秘" data-clear-alert="1"><text >便秘</text></view></view></view></view></view><view class="card"><view class="card-head"><text class="card-title">观察记录</text></view><view class="form-row"><view class="form-label">皮肤状况</view><view class="form-field"><input class="input" type="text" value="{{form.coat}}" bindinput="onField" data-field="coat" /></view></view><view class="form-row"><view class="form-label">异常描述</view><view class="form-field"><textarea class="textarea" value="{{form.abnormal}}" placeholder="可为空；如有异常请客观描述观察到的现象" bindinput="onField" data-field="abnormal"></textarea><view class="hint">仅记录客观现象，不填写医疗判断</view></view></view></view><view class="section-head"><text class="section-title">现场巡视照片</text><text class="req-mark">必拍 1 张，最多 6 张</text></view><view class="card"><view class="t11 muted mb8">已上传 {{photos.p1.items.length || 0}} / 6 张 · 自动附加拍摄时间水印</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p1.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p1" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p1" data-index="{{index}}">×</text></view><view class="photo photo-add" bindtap="choosePhoto" data-key="p1"><text class="ico">▣</text><text>拍照 / 上传</text></view></view></view></view><view class="footer"><button class="btn btn-primary" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">提交巡视</button></view></view>