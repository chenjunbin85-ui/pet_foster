<view class="staff-page has-foot"><view class="content"><include src="/templates/subject.wxml" /><view class="card"><view class="row gap10"><view class="avatar lg a1">豆</view><view class="grow"><view class="t15 strong">{{d.petName}}</view><view class="t12 muted mt4">柯基 · {{d.roomNo}} · 3 岁</view></view><text class="tag tag-orange">待评估</text></view><view class="divider"></view><view class="kv"><text class="k">订单编号</text><text class="v">{{d.orderNo}}</text></view><view class="kv"><text class="k">寄养时间</text><text class="v">11-06 至 11-12 · 共 6 天</text></view></view><view class="section-head"><text class="section-title">寄养期健康摘要</text><text class="section-extra">数据统计</text></view><view class="stat-grid c4"><view class="stat"><view class="stat-num">9</view><view class="stat-label">累计巡视 / 次</view></view><view class="stat"><view class="stat-num">2</view><view class="stat-label">异常记录 / 条</view></view><view class="stat"><view class="stat-num green">2</view><view class="stat-label">已闭环异常 / 条</view></view><view class="stat"><view class="stat-num">0</view><view class="stat-label">未闭环异常 / 条</view></view></view><view class="card"><view class="card-head"><text class="card-title">主要异常与处理摘要</text><text class="tag tag-green">全部闭环</text></view><view class="kv"><text class="k">AB202611060009 · 食欲</text><text class="v ok">已处置 · 已闭环</text></view><view class="kv"><text class="k">AB202611060012 · 皮肤</text><text class="v ok">已处置 · 已闭环</text></view><view class="divider"></view><view class="row between"><text class="t12 blue">查看详细记录</text><text class="ico">›</text></view></view><view class="section-head"><text class="section-title">离店健康评估</text><text class="req-mark">必填</text></view><view class="card"><view class="form-row"><view class="form-label req">离店结论</view><view class="form-field"><view class="choice-group"><view class="choice {{form.conclusion==='健康可放行'?'on':''}}" bindtap="pick" data-field="conclusion" data-value="健康可放行" data-clear-alert="1"><text >健康可放行</text></view><view class="choice {{form.conclusion==='需观察'?'on':''}}" bindtap="pick" data-field="conclusion" data-value="需观察" data-clear-alert="1"><text >需观察</text></view></view></view></view><view class="form-row"><view class="form-label req">当前健康状态</view><view class="form-field"><input class="input" type="text" value="{{form.healthState}}" bindinput="onField" data-field="healthState" /></view></view><view class="form-row"><view class="form-label">后续护理建议</view><view class="form-field"><textarea class="textarea" value="{{form.advice}}" placeholder="填写离店后的护理建议" bindinput="onField" data-field="advice"></textarea></view></view></view><view class="section-head"><text class="section-title">外部处方编号</text><text class="tag tag-gray">独立录入</text></view><view class="card"><view class="form-row"><view class="form-label">外部处方编号</view><view class="form-field"><input class="input" type="text" value="{{form.prescriptionRef}}" placeholder="仅录入处方编号" bindinput="onField" data-field="prescriptionRef" /></view></view><view class="hint">仅登记编号，不上传、不存储处方内容</view></view><view class="section-head"><text class="section-title">兽医签署</text><text class="req-mark">未签署不得放行</text></view><view class="card"><view class="kv"><text class="k">执业证号</text><text class="v ro">A3505****0218（自动带出）</text></view><view class="kv"><text class="k">签署兽医</text><text class="v">{{meName}}</text></view><view class="kv"><text class="k">签署时间</text><text class="v ro">提交时自动记录</text></view><view class="divider"></view><view class="sign-wrap"><view class="sign-pad"><canvas canvas-id="sign1" class="sign-canvas" bindtouchstart="signStart" bindtouchmove="signMove" bindtouchend="signEnd" data-id="sign1"></canvas><text class="sign-ph" wx:if="{{!form.signed}}">请兽医手写离店评估签名</text></view><view class="sign-actions"><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">清除</button><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">重新签署</button></view></view><view class="hint">未完成离店评估与签署时，离店交接将被阻断</view></view></view><view class="footer"><button class="btn btn-primary" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">签署放行离店</button><view class="footer-hint">存在未闭环异常时不得直接放行，须按业务规则处理</view></view></view>