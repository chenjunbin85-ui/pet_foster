<view class="staff-page"><view class="topbar"><view class="statusbar"><text>9:41</text><view class="sb-right"><text class="ico">▂▄▆</text><text class="ico">◔</text><text class="ico">▭</text></view></view><view class="navbar"><view class="nav-back" bindtap="goBack"><text class="ico">‹</text></view><text class="nav-title">{{title}}</text><view class="nav-capsule"><text class="ico">···</text><text class="ico">◎</text></view></view></view><view class="content"><view class="data-strip" wx:if="{{d.orderNo}}">订单 {{d.orderNo}} · {{d.petName}} · {{d.roomNo}} · {{d.status}}</view><view class="card"><view class="row gap10"><view class="avatar lg a4">团</view><view class="grow"><view class="t15 strong">{{d.petName}}</view><view class="t12 muted mt4">{{d.roomNo}} · 英国短毛猫</view></view></view><view class="divider"></view><view class="kv"><text class="k">订单编号</text><text class="v">{{d.orderNo}}</text></view></view><view class="section-head"><text class="section-title">护理类型</text><text class="section-extra">单选</text></view><view class="segment"><view class="segment-item {{tab.care==='feed'?'active':''}}" bindtap="switchTab" data-group="care" data-tab="feed">喂食</view><view class="segment-item {{tab.care==='walk'?'active':''}}" bindtap="switchTab" data-group="care" data-tab="walk">遛放</view><view class="segment-item {{tab.care==='clean'?'active':''}}" bindtap="switchTab" data-group="care" data-tab="clean">清洁</view></view><view wx:if="{{tab.care==='feed'}}"><view class="card"><view class="card-head"><text class="card-title">喂食记录</text><text class="tag tag-orange">当前类型</text></view><view class="form-row"><view class="form-label req">食物名称</view><view class="form-field"><input class="input" type="text" value="{{form.food}}" bindinput="onField" data-field="food" /></view></view><view class="form-row"><view class="form-label req">食物类型</view><view class="form-field"><view class="select" bindtap="toastMsg" data-msg="该项由订单自动带出，不可修改">干粮 <text class="ico">›</text></view></view></view><view class="form-row"><view class="form-label req">喂食份量</view><view class="form-field"><view class="inline-input"><input class="input" type="digit" value="{{form.amount}}" bindinput="onField" data-field="amount" /><text class="unit">克</text></view></view></view><view class="form-row"><view class="form-label req">进食情况</view><view class="form-field"><view class="choice-group"><view class="choice {{form.eat==='正常'?'on':''}}" bindtap="pick" data-field="eat" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.eat2==='少食'?'on':''}}" bindtap="pick" data-field="eat2" data-value="少食" data-clear-alert="1"><text >少食</text></view><view class="choice {{form.eat3==='拒食'?'on':''}}" bindtap="pick" data-field="eat3" data-value="拒食" data-clear-alert="1"><text >拒食</text></view></view></view></view><view class="form-row"><view class="form-label">备注</view><view class="form-field"><textarea class="textarea" value="{{form.remark}}" placeholder="填写本次喂食的补充说明" bindinput="onField" data-field="remark"></textarea></view></view></view></view><view wx:if="{{tab.care==='walk'}}"><view class="card"><view class="card-head"><text class="card-title">遛放记录</text><text class="tag tag-orange">当前类型</text></view><view class="form-row"><view class="form-label req">遛放开始时间</view><view class="form-field"><input class="input" type="text" value="{{form.startTime}}" bindinput="onField" data-field="startTime" /></view></view><view class="form-row"><view class="form-label req">遛放时长</view><view class="form-field"><view class="inline-input"><input class="input" type="digit" value="{{form.duration}}" bindinput="onField" data-field="duration" /><text class="unit">分钟</text></view></view></view><view class="form-row"><view class="form-label req">排便情况</view><view class="form-field"><view class="choice-group"><view class="choice {{form.walkstool==='正常'?'on':''}}" bindtap="pick" data-field="walkstool" data-value="正常" data-clear-alert="1"><text >正常</text></view><view class="choice {{form.walkstool2==='腹泻'?'on':''}}" bindtap="pick" data-field="walkstool2" data-value="腹泻" data-clear-alert="1"><text >腹泻</text></view><view class="choice {{form.walkstool3==='未排便'?'on':''}}" bindtap="pick" data-field="walkstool3" data-value="未排便" data-clear-alert="1"><text >未排便</text></view></view></view></view><view class="form-row"><view class="form-label req">活动表现</view><view class="form-field"><input class="input" type="text" value="{{form.exercise}}" placeholder="填写遛放期间活动表现" bindinput="onField" data-field="exercise" /></view></view><view class="form-row"><view class="form-label">备注</view><view class="form-field"><textarea class="textarea" value="{{form.remark2}}" placeholder="填写本次遛放的补充说明" bindinput="onField" data-field="remark2"></textarea></view></view></view></view><view wx:if="{{tab.care==='clean'}}"><view class="card"><view class="card-head"><text class="card-title">清洁记录</text><text class="tag tag-orange">当前类型</text></view><view class="form-row"><view class="form-label req">清洁部位</view><view class="form-field"><input class="input" type="text" value="{{form.part}}" placeholder="如猫砂盆、房舍地面" bindinput="onField" data-field="part" /></view></view><view class="form-row"><view class="form-label req">清洁用品</view><view class="form-field"><input class="input" type="text" value="{{form.supplies}}" placeholder="填写本次使用的清洁用品" bindinput="onField" data-field="supplies" /></view></view><view class="form-row"><view class="form-label req">清洁情况</view><view class="form-field"><view class="choice-group"><view class="choice {{form.cleanstate==='已完成'?'on':''}}" bindtap="pick" data-field="cleanstate" data-value="已完成" data-clear-alert="1"><text >已完成</text></view><view class="choice {{form.cleanstate2==='需复查'?'on':''}}" bindtap="pick" data-field="cleanstate2" data-value="需复查" data-clear-alert="1"><text >需复查</text></view></view></view></view><view class="form-row"><view class="form-label">备注</view><view class="form-field"><textarea class="textarea" value="{{form.remark3}}" placeholder="填写本次清洁的补充说明" bindinput="onField" data-field="remark3"></textarea></view></view></view></view><view class="section-head"><text class="section-title">通用记录</text></view><view class="card"><view class="form-row"><view class="form-label req">记录时间</view><view class="form-field"><input class="input" type="text" value="{{form.recordTime}}" bindinput="onField" data-field="recordTime" /><view class="hint">默认当前时间，支持手动修改</view></view></view><view class="form-row"><view class="form-label">护理照片</view><view class="form-field"><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p1.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p1" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p1" data-index="{{index}}">×</text></view><view class="photo photo-add" bindtap="choosePhoto" data-key="p1"><text class="ico">▣</text><text>拍照 / 上传</text></view></view><view class="hint">选填，支持多图上传与预览</view></view></view></view></view><view class="footer"><button class="btn btn-primary" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">提交记录</button><view class="safe-area"><text ></text></view></view></view>