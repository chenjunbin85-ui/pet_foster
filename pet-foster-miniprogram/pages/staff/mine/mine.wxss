/* 我的：复用 styles/staff.wxss，仅补数字区与三宫格 */
.staff-page .menu-row .tag-gray { margin-right: 4rpx; }
.staff-page .progress-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.staff-page .progress-cell {
  flex: 1; background: #fff; border-radius: var(--pf-r-card, 40rpx);
  padding: 24rpx 12rpx; text-align: center;
  border: 1rpx solid var(--line);
  }
.staff-page .progress-num { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.staff-page .progress-num.warn { color: var(--orange); }
.staff-page .progress-label { font-size: 22rpx; color: var(--sub); margin-top: 8rpx; }
.staff-page .quick-grid { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.staff-page .quick-item {
  position: relative; flex: 1; background: #fff; border-radius: var(--pf-r-card, 40rpx);
  padding: 24rpx 8rpx; text-align: center;
  border: 1rpx solid var(--line);
  }
.staff-page .quick-icon {
  width: 72rpx; height: 72rpx; margin: 0 auto 12rpx; border-radius: 50%;
  background: var(--orange-soft); color: var(--orange);
  font-size: 22rpx; line-height: 72rpx; font-weight: 600;
}
.staff-page .quick-label { font-size: 22rpx; color: var(--text); }
.staff-page .quick-badge {
  position: absolute; top: 12rpx; right: 20rpx;
  min-width: 28rpx; height: 28rpx; padding: 0 6rpx; border-radius: var(--pf-r-pill, 999rpx);
  background: var(--pf-danger, #C62828); color: #fff; font-size: 18rpx; line-height: 28rpx;
  box-sizing: border-box;
}
