<view class="staff-page has-foot"><view class="content"><include src="/templates/subject.wxml" /><view class="card"><view class="kv"><text class="k">异常编号</text><text class="v">AB202611060012</text></view><view class="kv"><text class="k">宠物名称 / 订单编号</text><text class="v">{{d.petName}} · {{d.orderNo}}</text></view><view class="kv"><text class="k">上报时间</text><text class="v">2026-11-06 18:05</text></view><view class="kv"><text class="k">当前状态</text><text class="v"><text class="tag tag-red">待复核</text></text></view></view><view class="section-head"><text class="section-title">护理员上报信息</text><text class="tag tag-gray">护理员上报内容 · 只读</text></view><view class="card" style="background:#FAF9F6"><view class="kv"><text class="k">异常类型</text><text class="v">食欲</text></view><view class="kv"><text class="k">上报时间</text><text class="v">2026-11-06 18:05</text></view><view class="kv"><text class="k">上报护理员</text><text class="v">林晓雯</text></view><view class="divider"></view><view class="t12 muted mb8">原始描述</view><view class="t13" style="line-height:1.75">18:00 巡视发现今日晚餐剩余约三分之二，饮水量较昨日减少，精神状态尚可。</view><view class="divider"></view><view class="photo-label">现场照片 · 点击可放大查看</view><view class="photo-grid"><view class="photo filled" wx:for="{{photos.p1.items}}" wx:key="uid" bindtap="previewPhoto" data-key="p1" data-url="{{item.url}}"><image wx:if="{{item.url}}" class="photo-img" src="{{item.url}}" mode="aspectFill" /><text wx:else class="photo-mark">爪</text><text class="photo-badge" wx:if="{{item.badge}}">{{item.badge}}</text><text class="photo-wm">{{item.wm}}</text><text class="photo-del" catchtap="removePhoto" data-key="p1" data-index="{{index}}">×</text></view></view><view class="hint">以上为护理员原始上报内容，兽医不可修改</view></view><view class="section-head"><text class="section-title">兽医复核与处置</text><text class="req-mark">独立记录</text></view><view class="card"><view class="t13 strong mb8">异常定级 <text class="red">*</text></view><view class="choice-grid"><view class="choice-card {{form.level==='轻微'?'on':''}}" bindtap="pick" data-field="level" data-value="轻微" data-clear-alert="1"><text >轻微</text></view><view class="choice-card {{form.level==='需处置'?'on':''}}" bindtap="pick" data-field="level" data-value="需处置" data-clear-alert="1"><text >需处置</text></view><view class="choice-card {{form.level==='需送医'?'on':''}}" bindtap="pick" data-field="level" data-value="需送医" data-clear-alert="1"><text >需送医</text></view><view class="choice-card {{form.level==='需隔离'?'on':''}}" bindtap="pick" data-field="level" data-value="需隔离" data-clear-alert="1"><text >需隔离</text></view></view><view class="divider"></view><view class="form-row"><view class="form-label req">处置措施</view><view class="form-field"><textarea class="textarea" value="{{form.treatment}}" placeholder="填写兽医处置措施" bindinput="onField" data-field="treatment"></textarea></view></view><view class="form-row"><view class="form-label req">护理员执行指示</view><view class="form-field"><textarea class="textarea" value="{{form.instruction}}" placeholder="填写下发护理员的执行指示" bindinput="onField" data-field="instruction"></textarea></view></view></view><view class="section-head"><text class="section-title">复核签署</text><text class="section-extra">verified_by 自动记录</text></view><view class="card"><view class="kv"><text class="k">复核兽医</text><text class="v">{{meName}}</text></view><view class="kv"><text class="k">执业证号</text><text class="v ro">A3505****0218（自动带出）</text></view><view class="kv"><text class="k">签署时间</text><text class="v ro">提交时自动记录</text></view><view class="divider"></view><view class="sign-wrap"><view class="sign-pad"><canvas canvas-id="sign1" class="sign-canvas" bindtouchstart="signStart" bindtouchmove="signMove" bindtouchend="signEnd" data-id="sign1"></canvas><text class="sign-ph" wx:if="{{!form.signed}}">请兽医手写复核签名</text></view><view class="sign-actions"><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">清除</button><button class="btn btn-outline btn-xs" bindtap="clearSign" data-id="sign1">重新签署</button></view></view><view class="hint">未签署不得视为完成复核</view></view></view><view class="footer"><button class="btn btn-primary" bindtap="submit" disabled="{{readOnly||submitting}}" loading="{{submitting}}">确认处置</button></view></view>