/* 确认订单 · 还原设计稿 checkout / panel / info-grid */
.checkout-page { padding: 40rpx 36rpx 380rpx;
  padding-top: 48rpx; }

/* 安心托付标题块 */
.checkout-heading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 6rpx 0 40rpx;
  background: linear-gradient(135deg, var(--pf-brand-soft, #FFF0E8) 0%, #FCE0C8 100%);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 28rpx 32rpx;
}
.checkout-symbol {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--pf-brand-soft, #FFF0E8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.symbol-icon { width: 52rpx; height: 52rpx; }
.checkout-heading-text { flex: 1; min-width: 0; }
.checkout-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--pf-ink, #1E1B18);
  line-height: 1.4;
}
.checkout-copy {
  font-size: 24rpx;
  color: var(--pf-ink-3, #7A7269);
  margin-top: 6rpx;
}

/* 面板 */
.panel {
  border: 1rpx solid var(--pf-border, #F0E6DE);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 32rpx;
  margin-bottom: 26rpx;
  background: #FFFFFF;
}

/* 入住信息两列网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 40rpx 24rpx;
}
.grid-cell { width: calc(50% - 12rpx); box-sizing: border-box; }
.grid-label {
  font-size: 24rpx;
  color: var(--pf-ink-3, #7A7269);
  margin-bottom: 12rpx;
}
.grid-value {
  font-size: 30rpx;
  color: var(--pf-ink, #1E1B18);
  font-weight: 500;
  line-height: 1.5;
}
.grid-breed { font-size: 26rpx; font-weight: 400; color: var(--pf-ink-2, #4A443E); }

.panel-divider {
  height: 1rpx;
  background: var(--pf-border, #F0E6DE);
  margin: 34rpx 0 26rpx;
}
.stay-summary { display: flex; flex-direction: column; gap: 12rpx; }
.stay-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 29rpx;
  color: var(--pf-ink, #1E1B18);
}
.stay-icon { width: 32rpx; height: 32rpx; opacity: 1; }
.stay-note {
  font-size: 23rpx;
  color: var(--pf-ink-3, #7A7269);
  padding-left: 42rpx;
}

/* 备注 */
.remark-input { margin-top: 0; }
.remark-count {
  text-align: right;
  font-size: 21rpx;
  color: var(--pf-ink-4, #A8A096);
  margin-top: 10rpx;
}

/* 协议勾选 */
.consent-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  margin: 6rpx 0 10rpx;
}
.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid var(--pf-ink-4, #A8A096);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.checkbox.checked { background: var(--pf-brand, #FF6B35); border-color: var(--pf-brand, #FF6B35); }
.check-mark { color: #FFFFFF; font-size: 22rpx; line-height: 1; }
.consent-text { font-size: 25rpx; color: var(--pf-ink-3, #7A7269); }
.consent-link { color: var(--pf-brand, #FF6B35); }

/* 底部金额 + 按钮 */
.checkout-actions { display: block; }
.checkout-amount {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.amount-label { font-size: 24rpx; color: var(--pf-ink-3, #7A7269); }
.amount-value {
  font-size: 60rpx;      /* 30px */
  font-weight: 600;
  font-family: Arial, sans-serif;
  color: var(--pf-brand, #FF6B35);
}
.consent-tip {
  text-align: center;
  font-size: 21rpx;
  color: var(--pf-ink-4, #A8A096);
  margin-top: 12rpx;
}

.policy-scroll { max-height: 520rpx; }
.policy-copy { text-align: left; line-height: 1.9; font-size: 26rpx; color: var(--pf-ink-2, #4A443E); }
.refund-rule { color: var(--pf-warning, #E65100); margin-top: 12rpx; }
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--pf-border, #F0E6DE);
}
.coupon-row:last-child { border-bottom: none; }
.coupon-row.on { background: var(--pf-brand-soft, #FFF0E8); margin: 0 -20rpx; padding: 22rpx 20rpx; border-radius: var(--pf-r-tile, 24rpx); }
.coupon-name { font-size: 28rpx; font-weight: 600; color: var(--pf-ink, #1E1B18); }
.coupon-cond { font-size: 22rpx; color: var(--pf-ink-4, #A8A096); margin-top: 6rpx; }
.coupon-discount { font-size: 34rpx; font-weight: 600; color: var(--pf-brand, #FF6B35); font-family: Arial, sans-serif; }

.coupon-deduct { color: var(--pf-success, #2E7D32); font-weight: 600; }

/* ===== Warm Petcare OS · 版式对齐 ===== */
