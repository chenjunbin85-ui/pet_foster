<view class="page checkout-page">
  <!-- 页头 -->
  <view class="page-heading">
    <view class="page-heading-title">
      <text class="back-chevron" bindtap="back">‹</text>
      <text>确认订单</text>
    </view>
  </view>

  <!-- 安心托付标题 -->
  <view class="checkout-heading">
    <view class="checkout-symbol">
      <image class="symbol-icon" src="/images/ass-shield.png" mode="aspectFit" />
    </view>
    <view class="checkout-heading-text">
      <view class="checkout-title">确认这一次安心托付</view>
      <view class="checkout-copy">核对入住信息，提交后前往在线支付。</view>
    </view>
  </view>

  <!-- 入住信息 -->
  <view class="panel">
    <view class="section-head"><text class="section-head-title">入住信息</text></view>
    <view class="info-grid">
      <view class="grid-cell">
        <view class="grid-label">入住宠物</view>
        <view class="grid-value">{{pet.name}}<text class="grid-breed">{{pet.breed ? '（' + pet.breed + '）' : ''}}</text></view>
      </view>
      <view class="grid-cell">
        <view class="grid-label">寄养房型</view>
        <view class="grid-value">{{price.levelName}}</view>
      </view>
      <view class="grid-cell">
        <view class="grid-label">入住时间</view>
        <view class="grid-value">{{start}} 10:00</view>
      </view>
      <view class="grid-cell">
        <view class="grid-label">离店时间</view>
        <view class="grid-value">{{end}} 18:00</view>
      </view>
    </view>

    <view class="panel-divider"></view>

    <view class="stay-summary">
      <view class="stay-main">
        <image class="stay-icon" src="/images/icon-clock-gray.png" mode="aspectFit" />
        <text>寄养 {{stayLabel}}</text>
      </view>
      <view class="stay-note">按入住晚数计算；入住建议 10:00，离店建议 18:00</view>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="panel">
    <view class="section-head"><text class="section-head-title">价格明细</text></view>
    <view class="info-row">
      <text class="info-label">房费（{{price.levelName}}）</text>
      <text class="info-value">¥{{price.pricePerDay}} × {{days}}晚 = ¥{{roomFee}}</text>
    </view>
    <view wx:for="{{extraItems}}" wx:key="id" class="info-row">
      <text class="info-label">增值·{{item.name}}</text>
      <text class="info-value">¥{{item.price}}</text>
    </view>
    <view wx:if="{{selectedCoupon}}" class="info-row">
      <text class="info-label">优惠券抵扣（{{selectedCoupon.name}}）</text>
      <text class="info-value coupon-deduct">-¥{{discountFee}}</text>
    </view>
    <view class="total-row">
      <text>合计金额</text>
      <text class="total-row-amount">¥{{totalFee}}</text>
    </view>
    <view class="form-hint">含每日喂养、基础照护与清洁，无押金；不含医疗及另行协商服务。</view>
    <view class="form-hint refund-rule">取消规则：入住前 24 小时可免费取消并原路退款；逾期取消按 1 晚房费收取手续费。</view>
  </view>

  <!-- 联系人信息 -->
  <view class="panel">
    <view class="section-head"><text class="section-head-title">联系人信息</text></view>
    <view class="form-row">
      <view class="form-label">姓名</view>
      <input class="form-input" placeholder="请输入联系人姓名" placeholder-class="placeholder" maxlength="20" value="{{contactName}}" bindinput="onContactNameInput" />
    </view>
    <view class="form-row">
      <view class="form-label">电话</view>
      <input class="form-input" type="number" placeholder="请输入手机号" placeholder-class="placeholder" maxlength="11" value="{{contactPhone}}" bindinput="onContactPhoneInput" />
    </view>
    <view class="form-row">
      <view class="form-label">紧急联系人</view>
      <input class="form-input" type="number" placeholder="选填，备用联系电话" placeholder-class="placeholder" maxlength="11" value="{{emergencyPhone}}" bindinput="onEmergencyPhoneInput" />
    </view>
  </view>

  <!-- 门店信息 -->
  <view class="panel" wx:if="{{store}}">
    <view class="section-head"><text class="section-head-title">寄养门店</text></view>
    <view class="info-row">
      <text class="info-label">门店</text>
      <text class="info-value">{{store.name}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">地址</text>
      <text class="info-value">{{store.address}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">营业时间</text>
      <text class="info-value">{{store.openHours}}</text>
    </view>
  </view>

  <!-- 优惠券 -->
  <view class="panel" wx:if="{{coupons.length > 0}}">
    <view class="section-head"><text class="section-head-title">优惠券</text></view>
    <view
      wx:for="{{coupons}}"
      wx:key="couponId"
      class="coupon-row {{selectedCoupon && selectedCoupon.couponId === item.couponId ? 'on' : ''}}"
      data-id="{{item.couponId}}"
      bindtap="selectCoupon"
    >
      <view class="coupon-info">
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-cond">满 {{item.minAmount}} 可用 · 有效期至 {{item.expireAt}}</view>
      </view>
      <view class="coupon-discount">-¥{{item.discount}}</view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="panel">
    <view class="section-head"><text class="section-head-title">备注（选填）</text></view>
    <textarea
      class="textarea remark-input"
      placeholder="如：早晚各喂一次、需按时喂药"
      placeholder-class="placeholder"
      maxlength="200"
      value="{{remark}}"
      bindinput="onRemarkInput"
    ></textarea>
    <view class="remark-count">{{remark.length}}/200</view>
  </view>

  <!-- 协议 -->
  <view class="consent-row" bindtap="toggleAgree">
    <view class="checkbox {{agreed ? 'checked' : ''}}">
      <text wx:if="{{agreed}}" class="check-mark">✓</text>
    </view>
    <view class="consent-text">
      <text>我已阅读并同意</text>
      <text class="consent-link" catchtap="openPolicy" data-type="service">《宠物寄养服务协议》</text>
      <text>与</text>
      <text class="consent-link" catchtap="openPolicy" data-type="notice">《用户须知》</text>
    </view>
  </view>

  <!-- 底部动作栏 -->
  <view class="action-bar checkout-actions">
    <view class="checkout-amount">
      <text class="amount-label">应付金额 · {{stayLabel}}</text>
      <text class="amount-value">¥{{totalFee}}</text>
    </view>
    <button
      class="btn {{agreed ? 'btn-primary' : 'btn-disabled'}}"
      hover-class="{{agreed ? 'btn-hover' : ''}}"
      loading="{{submitting}}"
      bindtap="submit"
    >提交订单</button>
    <view wx:if="{{!agreed}}" class="consent-tip">请先阅读并勾选寄养服务协议</view>
  </view>

  <!-- 协议弹层 -->
  <view class="modal-mask" wx:if="{{showPolicy}}" bindtap="closePolicy">
    <view class="modal" catchtap="noop">
      <view class="modal-title">{{policyTitle}}</view>
      <scroll-view scroll-y class="policy-scroll">
        <view class="modal-copy policy-copy">{{POLICY_TEXT}}</view>
      </scroll-view>
      <view class="modal-actions">
        <button class="btn btn-secondary" hover-class="btn-hover" bindtap="closePolicy">关闭</button>
      </view>
    </view>
  </view>
</view>
