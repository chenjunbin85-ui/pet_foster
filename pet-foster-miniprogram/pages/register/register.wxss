/* 注册页 · 与登录页同一套 token */
.register-page {
  min-height: 100vh;
  background: var(--pf-canvas, #FFF8F3);
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

/* 品牌区：与登录页同一锁标，下移量略小（表单字段更多） */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 56rpx;
}
.brand-logo {
  width: 166rpx;
  height: 166rpx;
  border-radius: 50%;
  background: var(--pf-brand-soft, #FFF0E8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.brand-paw { width: 120rpx; height: 120rpx; }
.brand-name {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--pf-ink, #1E1B18);
}

/* 表单卡 */
.login-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04), 0 4rpx 12rpx -2rpx rgba(92, 60, 30, 0.02);
  padding: 12rpx 32rpx 36rpx;
}
.field {
  padding: 20rpx 0 12rpx;
  border-bottom: 1rpx solid var(--pf-surface-low, #FAF2EC);
}
.field-label {
  font-size: 22rpx;
  color: var(--pf-ink-3, #7A7269);
  margin-bottom: 2rpx;
}
.field-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: var(--pf-ink, #1E1B18);
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}
.password-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.password-input { flex: 1; }
.eye-icon { width: 36rpx; height: 36rpx; opacity: 0.5; flex-shrink: 0; }

/* 协议勾选 */
.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx 0 32rpx;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--pf-border, #F0E6DE);
  margin-top: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.checkbox.checked {
  background: var(--pf-brand, #FF6B35);
  border-color: var(--pf-brand, #FF6B35);
}
.check-mark { color: #FFFFFF; font-size: 22rpx; line-height: 1; }
.agree-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--pf-ink-3, #7A7269);
  line-height: 1.6;
}
.link { color: var(--pf-brand, #FF6B35); }

.login-btn {
  border-radius: 24rpx;
  height: 96rpx;
  font-size: 32rpx;
}
.login-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--pf-brand, #FF6B35);
  margin-top: 18rpx;
  line-height: 1.6;
}

/* 底部：已有账号 */
.login-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--pf-ink-3, #7A7269);
}
.foot-link {
  color: var(--pf-brand, #FF6B35);
}

.policy-scroll { max-height: 480rpx; }
.policy-copy { text-align: left; line-height: 1.9; font-size: 26rpx; color: var(--pf-ink-2, #4A443E); }
