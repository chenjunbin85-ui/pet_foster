/* 注册页 · 与登录页同一套 token */
.register-page {
  min-height: 100vh;
  background: #F5F1EB;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

/* 品牌区：与登录页同一锁标，下移量略小（表单字段更多） */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 56rpx;
}
.brand-logo {
  width: 166rpx;
  height: 166rpx;
  border-radius: 50%;
  background: #FEF3E8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.brand-paw { width: 120rpx; height: 120rpx; }
.brand-name {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #1A1A1A;
}

/* 表单卡 */
.login-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  padding: 12rpx 32rpx 36rpx;
}
.field {
  padding: 20rpx 0 12rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.field-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 2rpx;
}
.field-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}
.password-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.password-input { flex: 1; }
.eye-icon { width: 36rpx; height: 36rpx; opacity: 0.5; flex-shrink: 0; }

/* 协议勾选 */
.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx 0 32rpx;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 1rpx solid #DDD6CC;
  margin-top: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.checkbox.checked {
  background: #E8743B;
  border-color: #E8743B;
}
.check-mark { color: #FFFFFF; font-size: 22rpx; line-height: 1; }
.agree-text {
  flex: 1;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
.link { color: #E8743B; }

.login-btn {
  border-radius: 24rpx;
  height: 96rpx;
  font-size: 32rpx;
}
.login-tip {
  text-align: center;
  font-size: 22rpx;
  color: #E8743B;
  margin-top: 18rpx;
  line-height: 1.6;
}

/* 底部：已有账号 */
.login-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 36rpx;
  font-size: 26rpx;
  color: #999999;
}
.foot-link {
  color: #E8743B;
}

.policy-scroll { max-height: 480rpx; }
.policy-copy { text-align: left; line-height: 1.9; font-size: 26rpx; color: #5C5750; }
