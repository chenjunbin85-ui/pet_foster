/* 个人中心 · 与首页/历史订单同一套 token */
.mine-page {
  padding: 34rpx 32rpx 60rpx;
  padding-top: 48rpx;
}
.heading-title {
  font-size: 52rpx;      /* 26px */
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
  color: var(--pf-ink, #1E1B18);
}

/* 概览卡 */
.overview-card {
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04), 0 4rpx 12rpx -2rpx rgba(92, 60, 30, 0.02);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.overview-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.overview-avatar {
  width: 112rpx;         /* 56px */
  height: 112rpx;
  border-radius: 50%;
  background: var(--pf-brand-soft, #FFF0E8);
  color: var(--pf-brand, #FF6B35);
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.overview-info { flex: 1; min-width: 0; }
.overview-name {
  font-size: 34rpx;      /* 17px */
  font-weight: 600;
  color: var(--pf-ink, #1E1B18);
  line-height: 1.3;
}
.overview-phone {
  font-size: 24rpx;      /* 12px */
  color: var(--pf-ink-3, #7A7269);
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
}
.overview-edit {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--pf-brand, #FF6B35);
  font-size: 24rpx;
  flex-shrink: 0;
}
.chev-icon { width: 22rpx; height: 22rpx; }

.overview-divider {
  height: 1rpx;
  background: var(--pf-surface-low, #FAF2EC);
  margin: 26rpx 0 6rpx;
}

/* 统计三列 */
.overview-stats {
  display: flex;
  align-items: stretch;
}
.stat-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 10rpx;
  border-right: 1rpx solid var(--pf-surface-low, #FAF2EC);
}
.stat-cell:last-child { border-right: none; }
.stat-num {
  font-size: 44rpx;      /* 22px */
  font-weight: 700;
  color: var(--pf-ink, #1E1B18);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 22rpx;      /* 11px */
  color: var(--pf-ink-3, #7A7269);
  margin-top: 8rpx;
}

/* 菜单卡：纯文字行 + 箭头，无图标 */
.menu-card {
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04), 0 4rpx 12rpx -2rpx rgba(92, 60, 30, 0.02);
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;    /* 52px */
  border-bottom: 1rpx solid var(--pf-surface-low, #FAF2EC);
}
.menu-row:last-child { border-bottom: none; }
.menu-label {
  flex: 1;
  font-size: 30rpx;      /* 15px */
  color: var(--pf-ink, #1E1B18);
}
.menu-chev {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

/* 退出登录 */
.logout-bar { padding: 4rpx 0 0; }
.logout-btn {
  background: #FFFFFF;
  color: var(--pf-ink-2, #4A443E);
  border: 1rpx solid var(--pf-border, #F0E6DE);
  border-radius: 24rpx;
  font-weight: 500;
}
.logout-btn.btn-hover { background: var(--pf-canvas, #FFF8F3); }
.version-note {
  text-align: center;
  color: var(--pf-ink-4, #A8A096);
  font-size: 20rpx;
  margin-top: 26rpx;
}
/* 方案 B：自绘底栏 fixed，一级页自行留白，避免内容被压住 */
.page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
