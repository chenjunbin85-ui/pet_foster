/* 个人中心 · 与首页/历史订单同一套 token */
.mine-page {
  padding: 34rpx 32rpx 60rpx;
  padding-top: 176rpx;
}
.heading-title {
  font-size: 52rpx;      /* 26px */
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
  color: #1A1A1A;
}

/* 概览卡 */
.overview-card {
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.overview-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.overview-avatar {
  width: 112rpx;         /* 56px */
  height: 112rpx;
  border-radius: 50%;
  background: #FEF3E8;
  color: #E8743B;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.overview-info { flex: 1; min-width: 0; }
.overview-name {
  font-size: 34rpx;      /* 17px */
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.3;
}
.overview-phone {
  font-size: 24rpx;      /* 12px */
  color: #999999;
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
}
.overview-edit {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #E8743B;
  font-size: 24rpx;
  flex-shrink: 0;
}
.chev-icon { width: 22rpx; height: 22rpx; }

.overview-divider {
  height: 1rpx;
  background: #F5F5F5;
  margin: 26rpx 0 6rpx;
}

/* 统计三列 */
.overview-stats {
  display: flex;
  align-items: stretch;
}
.stat-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 10rpx;
  border-right: 1rpx solid #F5F5F5;
}
.stat-cell:last-child { border-right: none; }
.stat-num {
  font-size: 44rpx;      /* 22px */
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 22rpx;      /* 11px */
  color: #999999;
  margin-top: 8rpx;
}

/* 菜单卡：纯文字行 + 箭头，无图标 */
.menu-card {
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;    /* 52px */
  border-bottom: 1rpx solid #F5F5F5;
}
.menu-row:last-child { border-bottom: none; }
.menu-label {
  flex: 1;
  font-size: 30rpx;      /* 15px */
  color: #1A1A1A;
}
.menu-chev {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

/* 退出登录 */
.logout-bar { padding: 4rpx 0 0; }
.logout-btn {
  background: #FFFFFF;
  color: #666666;
  border: 1rpx solid #E6E1D9;
  border-radius: 24rpx;
  font-weight: 500;
}
.logout-btn.btn-hover { background: #F5F1EB; }
.version-note {
  text-align: center;
  color: #BBBBBB;
  font-size: 20rpx;
  margin-top: 26rpx;
}
