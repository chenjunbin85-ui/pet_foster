<view class="login-page">
  <!-- 品牌区：顶部唯一锚点 -->
  <view class="brand">
    <view class="brand-logo">
      <image class="brand-paw" src="/images/logo.png" mode="aspectFit" />
    </view>
    <text class="brand-kicker">WARM PETCARE OS</text>
    <view class="brand-name">毛球旅馆</view>
    <view class="brand-slogan">让每一次托付，都温暖如家</view>
  </view>

  <!-- 登录表单卡 -->
  <view class="login-card">
    <view class="field">
      <view class="field-label">手机号</view>
      <input
        class="field-input"
        type="text"
        maxlength="30"
        placeholder="请输入手机号"
        placeholder-class="placeholder"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="field">
      <view class="field-label">密码</view>
      <view class="password-wrap">
        <input
          class="field-input password-input"
          password="{{!showPassword}}"
          maxlength="32"
          placeholder="请输入密码"
          placeholder-class="placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <image class="eye-icon" src="/images/icon-eye-gray.png" mode="aspectFit" bindtap="togglePassword" />
      </view>
    </view>

    <view class="forgot-row">
      <text class="forgot-link" bindtap="openContact">忘记密码？</text>
    </view>

    <!-- 协议勾选（默认不勾选） -->
    <view class="agree-row">
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">
        <text wx:if="{{agreed}}" class="check-mark">✓</text>
      </view>
      <view class="agree-text">
        <text>我已阅读并同意</text>
        <text class="link" data-kind="用户协议" bindtap="openPolicy">《用户协议》</text>
        <text>和</text>
        <text class="link" data-kind="隐私政策" bindtap="openPolicy">《隐私政策》</text>
      </view>
    </view>

    <button
      class="btn {{canSubmit ? 'btn-primary' : 'btn-disabled'}} login-btn"
      hover-class="{{canSubmit ? 'btn-hover' : ''}}"
      loading="{{loading}}"
      bindtap="submit"
    >登录</button>
  </view>

  <!-- 底部链接 -->
  <view class="login-foot">
    <text class="foot-text">还没有账号？</text>
    <text class="foot-link" bindtap="goRegister">注册</text>
    <text class="foot-sep">|</text>
    <text class="foot-link" bindtap="openContact">遇到问题？</text>
  </view>

  <view class="demo-line">
    <text>演示账号 13800138001 / 123456</text>
    <text class="demo-fill" bindtap="fillDemo">一键填入</text>
  </view>

  <!-- 联系门店 -->
  <view class="mask" wx:if="{{showContact}}" bindtap="closeContact">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">联系门店</view>
      <view class="sheet-copy">忘记密码、账号与安全请通过门店人工处理。\n客服电话：400-080-6060\n营业时间：09:00–21:00</view>
      <view class="sheet-actions">
        <button class="btn btn-secondary" hover-class="btn-hover" bindtap="closeContact">取消</button>
        <button class="btn btn-primary" hover-class="btn-hover" bindtap="closeContact">拨打客服</button>
      </view>
    </view>
  </view>

  <!-- 协议弹层 -->
  <view class="modal-mask" wx:if="{{showPolicy}}" bindtap="closePolicy">
    <view class="modal" catchtap="noop">
      <view class="modal-title">{{policyTitle}}</view>
      <scroll-view scroll-y class="policy-scroll">
        <view class="modal-copy policy-copy">{{policyContent}}</view>
      </scroll-view>
      <view class="modal-actions">
        <button class="btn btn-secondary" hover-class="btn-hover" bindtap="closePolicy">关闭</button>
      </view>
    </view>
  </view>
</view>