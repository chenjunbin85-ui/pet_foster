/* 登录页 · 与首页/订单/我的同一套 token */
.login-page {
  min-height: 100vh;
  background: var(--pf-canvas, #FFF8F3);
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

/* 品牌区：顶部唯一锚点，垂直居中偏上 */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 210rpx 0 56rpx;
}
.brand-logo {
  width: 166rpx;        /* 83px（放大 115%） */
  height: 166rpx;
  border-radius: 50%;
  background: var(--pf-brand-soft, #FFF0E8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.brand-paw { width: 120rpx; height: 120rpx; }
.brand-name {
  font-size: 40rpx;      /* 20px */
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--pf-ink, #1E1B18);
}

/* 表单卡 */
.login-card {
  background: #FFFFFF;
  border-radius: var(--pf-r-card, 40rpx);
  border: 1rpx solid var(--pf-border, #F0E6DE);
  box-shadow: 0 24rpx 64rpx rgba(42, 39, 35, 0.08);
  padding: 32rpx 32rpx 40rpx;
}
.field {
  padding: 20rpx 0 12rpx;
  border-bottom: 1rpx solid var(--pf-surface-low, #FAF2EC);
}
.field-label {
  font-size: 22rpx;      /* 11px */
  color: var(--pf-ink-3, #7A7269);
  margin-bottom: 2rpx;
}
.field-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;      /* 15px */
  color: var(--pf-ink, #1E1B18);
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}
.password-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.password-input { flex: 1; }
.eye-icon { width: 36rpx; height: 36rpx; opacity: 0.5; flex-shrink: 0; }

.forgot-row {
  text-align: right;
  padding: 24rpx 0 8rpx;
}
.forgot-link {
  font-size: 24rpx;
  color: var(--pf-ink-3, #7A7269);
}

/* 协议勾选 */
.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx 0 32rpx;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--pf-border, #F0E6DE);
  margin-top: 3rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.checkbox.checked {
  background: var(--pf-brand, #FF6B35);
  border-color: var(--pf-brand, #FF6B35);
}
.check-mark { color: #FFFFFF; font-size: 22rpx; line-height: 1; }
.agree-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--pf-ink-3, #7A7269);
  line-height: 1.6;
}
.link { color: var(--pf-brand, #FF6B35); }

.login-btn {
  border-radius: var(--pf-r-pill, 999rpx);
  height: 96rpx;
  font-size: 32rpx;
}
.login-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--pf-ink-4, #A8A096);
  margin-top: 18rpx;
  line-height: 1.6;
}

/* 底部链接 */
.login-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 36rpx;
}
.foot-text {
  font-size: 26rpx;
  color: var(--pf-ink-3, #7A7269);
}
.foot-link {
  font-size: 26rpx;
  color: var(--pf-brand, #FF6B35);
}
.foot-sep {
  color: var(--pf-border, #F0E6DE);
  font-size: 24rpx;
}

.demo-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--pf-ink-4, #A8A096);
}
.demo-fill {
  color: var(--pf-brand, #FF6B35);
}

.policy-scroll { max-height: 480rpx; }
.policy-copy { text-align: left; line-height: 1.9; font-size: 26rpx; color: var(--pf-ink-2, #4A443E); }

/* ===== Warm Petcare OS · 版式对齐 ===== */
.brand-slogan { font-size: 24rpx; color: var(--pf-ink-3, #7A7269); margin-top: 12rpx; letter-spacing: 1rpx; }
.brand-kicker { font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; color: var(--pf-brand-ink, #E55620); margin-bottom: 8rpx; }
