/* 历史订单 · 现代简约卡片（375px 基准 → 1px = 2rpx）
   底色 #f5f1eb / 卡片 #ffffff 12px / 主字 #1a1a1a / 次字 #999 / 强调 #e8743b */
.orders-page {
  padding: 34rpx 32rpx 60rpx;
  padding-top: 176rpx;
}

/* 页头 */
.page-heading { margin-bottom: 40rpx; }
.heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.heading-title {
  font-size: 52rpx;      /* 26px */
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
  color: #1A1A1A;
}
.history-add {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #E8743B;
  font-size: 24rpx;
  flex-shrink: 0;
  min-height: 60rpx;
}
.add-icon { width: 24rpx; height: 24rpx; }
.order-count {
  margin-top: 12rpx;
  font-size: 26rpx;      /* 13px */
  font-weight: 500;
  color: #E8743B;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  margin-bottom: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.9;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  margin-left: 16rpx;
  font-size: 28rpx;      /* 14px */
  color: #1A1A1A;
}
.placeholder { color: #BBBBBB; }
.search-clear {
  width: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #BBBBBB;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* 筛选胶囊 */
.filter-tabs {
  display: flex;
  white-space: nowrap;
  width: 100%;
  margin-bottom: 32rpx;
}
.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 12rpx 30rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEEEEE;
  border-radius: 36rpx;
  color: #666666;
  font-size: 26rpx;      /* 13px */
  line-height: 1.3;
  box-sizing: border-box;
}
.filter-tab:last-child { margin-right: 0; }
.filter-tab.active {
  border-color: transparent;
  background: #E8743B;
  color: #FFFFFF;
  font-weight: 500;
}

/* 订单卡：左侧 3px 状态竖条 */
.order-card {
  position: relative;
  background: #FFFFFF;
  border-left: 6rpx solid #D6D0C7;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}
.bar-orange { border-left-color: #E8743B; }
.bar-blue { border-left-color: #5B8DD9; }
.bar-green { border-left-color: #7FA886; }
.bar-gray { border-left-color: #D6D0C7; }

/* 顶部行：订单号 + 状态标签 */
.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.order-no {
  min-width: 0;
  font-size: 22rpx;      /* 11px */
  color: #999999;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.status-tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;      /* 10px */
  line-height: 1.4;
  font-weight: 400;
}
.status-tag::before { display: none; }
.status-tag.badge-blue { background: #E8F0FE; color: #5B8DD9; }
.status-tag.badge-orange { background: #FFF1E6; color: #E8743B; }
.status-tag.badge-green { background: #EAF3EC; color: #6E9C78; }
.status-tag.badge-gray { background: #F2F1EF; color: #9B968F; }

/* 主体行：头像 + 宠物信息 + 价格 */
.order-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 20rpx;
}
.order-pet-avatar {
  width: 76rpx;          /* 38px */
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FEF3E8, #FFE8D6);
  flex-shrink: 0;
}
.order-pet-info { flex: 1; min-width: 0; }
.order-pet-name {
  font-size: 28rpx;      /* 14px */
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.35;
}
.order-pet-breed {
  margin-left: 6rpx;
  font-size: 22rpx;      /* 11px */
  font-weight: 400;
  color: #999999;
}
.order-pet-room {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888888;
}
.order-pet-date {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #666666;
}
.order-pet-days {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #AAAAAA;
}
.order-fee {
  flex-shrink: 0;
  font-size: 34rpx;      /* 17px */
  font-weight: 700;
  font-family: Arial, sans-serif;
  color: #E8743B;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.fee-yuan {
  margin-right: 2rpx;
  font-size: 24rpx;      /* 12px */
  font-weight: 500;
}

/* 卡片操作 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 14rpx;
}
.action-cancel {
  padding: 8rpx 22rpx;
  border: 1rpx solid #E6E1D9;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 空态 / 加载 */
.empty { padding: 120rpx 40rpx; text-align: center; }
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.list-end {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #AAAAAA;
}
