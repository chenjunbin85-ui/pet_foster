/* 历史订单 · 现代简约卡片（375px 基准 → 1px = 2rpx）
   底色 var(--pf-canvas, #FFF8F3) / 卡片 #ffffff 12px / 主字 var(--pf-ink, #1E1B18) / 次字 #999 / 强调 var(--pf-brand, #FF6B35) */
.orders-page {
  padding: 34rpx 32rpx 60rpx;
  padding-top: 48rpx;
}

/* 页头 */
.page-heading { margin-bottom: 40rpx; }
.heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.heading-title {
  font-size: 52rpx;      /* 26px */
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
  color: var(--pf-ink, #1E1B18);
}
.history-add {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--pf-brand, #FF6B35);
  font-size: 24rpx;
  flex-shrink: 0;
  min-height: 60rpx;
}
.add-icon { width: 24rpx; height: 24rpx; }
.order-count {
  margin-top: 12rpx;
  font-size: 26rpx;      /* 13px */
  font-weight: 500;
  color: var(--pf-brand, #FF6B35);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  margin-bottom: 32rpx;
  background: #FFFFFF;
  border-radius: var(--pf-r-pill, 999rpx);
  box-shadow: var(--pf-shadow-card, 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04));
  border: 1rpx solid var(--pf-border, #F0E6DE);
  }
.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.9;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  margin-left: 16rpx;
  font-size: 28rpx;      /* 14px */
  color: var(--pf-ink, #1E1B18);
}
.placeholder { color: var(--pf-ink-4, #A8A096); }
.search-clear {
  width: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pf-ink-4, #A8A096);
  font-size: 26rpx;
  flex-shrink: 0;
}

/* 筛选胶囊 */
.filter-tabs {
  display: flex;
  white-space: nowrap;
  width: 100%;
  margin-bottom: 32rpx;
}
.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 12rpx 30rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--pf-border, #F0E6DE);
  border-radius: var(--pf-r-pill, 999rpx);
  color: var(--pf-ink-2, #4A443E);
  font-size: 26rpx;      /* 13px */
  line-height: 1.3;
  box-sizing: border-box;
}
.filter-tab:last-child { margin-right: 0; }
.filter-tab.active {
  border-color: #FFFFFF;
  background: var(--pf-brand, #FF6B35);
  color: #FFFFFF;
  font-weight: 500;
  border: 1rpx solid var(--pf-brand, #FF6B35);
  }

/* 订单卡：左侧 3px 状态竖条 */
.order-card {
  position: relative;
  background: #FFFFFF;
  border-left: 6rpx solid var(--pf-border, #F0E6DE);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--pf-shadow-card, 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04));
  overflow: hidden;
  border: 1rpx solid var(--pf-border, #F0E6DE);
  }
.bar-orange { border-left-color: var(--pf-brand, #FF6B35); }
.bar-blue { border-left-color: var(--pf-blue, #3B729E); }
.bar-green { border-left-color: #7FA886; }
.bar-gray { border-left-color: var(--pf-border, #F0E6DE); }

/* 顶部行：订单号 + 状态标签 */
.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--pf-surface-low, #FAF2EC);
}
.order-no {
  min-width: 0;
  font-size: 22rpx;      /* 11px */
  color: var(--pf-ink-3, #7A7269);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.status-tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--pf-r-pill, 999rpx);
  font-size: 20rpx;      /* 10px */
  line-height: 1.4;
  font-weight: 600;
}
.status-tag::before { display: none; }
.status-tag.badge-blue { background: #E8F0FE; color: var(--pf-blue, #3B729E); }
.status-tag.badge-orange { background: #FFF1E6; color: var(--pf-brand, #FF6B35); }
.status-tag.badge-green { background: #EAF3EC; color: #6E9C78; }
.status-tag.badge-gray { background: #F2F1EF; color: #9B968F; }

/* 主体行：头像 + 宠物信息 + 价格 */
.order-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 20rpx;
}
.order-pet-avatar {
  width: 76rpx;          /* 38px */
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--pf-brand-soft, #FFF0E8), #FFE8D6);
  flex-shrink: 0;
}
.order-pet-info { flex: 1; min-width: 0; }
.order-pet-name {
  font-size: 28rpx;      /* 14px */
  font-weight: 600;
  color: var(--pf-ink, #1E1B18);
  line-height: 1.35;
}
.order-pet-breed {
  margin-left: 6rpx;
  font-size: 22rpx;      /* 11px */
  font-weight: 400;
  color: var(--pf-ink-3, #7A7269);
}
.order-pet-room {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888888;
}
.order-pet-date {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--pf-ink-2, #4A443E);
}
.order-pet-days {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--pf-ink-3, #7A7269);
}
.order-fee {
  flex-shrink: 0;
  font-size: 34rpx;      /* 17px */
  font-weight: 700;
  font-family: Arial, sans-serif;
  color: var(--pf-brand, #FF6B35);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.fee-yuan {
  margin-right: 2rpx;
  font-size: 24rpx;      /* 12px */
  font-weight: 500;
}

/* 卡片操作 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 14rpx;
}
.action-cancel {
  padding: 8rpx 22rpx;
  border: 1rpx solid var(--pf-border, #F0E6DE);
  border-radius: var(--pf-r-pill, 999rpx);
  font-size: 22rpx;
  color: var(--pf-ink-3, #7A7269);
}

/* 空态 / 加载 */
.empty { padding: 120rpx 40rpx; text-align: center; }
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pf-ink, #1E1B18);
}
.list-end {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--pf-ink-3, #7A7269);
}
/* 方案 B：自绘底栏 fixed，一级页自行留白，避免内容被压住 */
.page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
