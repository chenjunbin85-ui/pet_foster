/* ============================================================
   护宠宝 · 员工端样式
   形态：原生小程序（原生导航栏 + 页面内滚动 + 底部固定操作栏）
   基准：390pt 视口，1px ≈ 2rpx
   注意：所有规则都以 .staff-page 作用域开头，避免与 app.wxss
        的客户端全局类（.card/.btn/.input/.form-row/.section-head）
        互相覆盖。
   ============================================================ */

.staff-page {
  /* 统一引用 app.wxss 的 Warm Petcare OS 令牌，员工/客户端不再各执一套色 */
  --bg: var(--pf-canvas, #FFF8F3);
  --card: var(--pf-surface, #FFFFFF);
  --ink: var(--pf-ink, #1E1B18);
  --ink-2: var(--pf-ink-2, #4A443E);
  --muted: var(--pf-ink-3, #7A7269);
  --line: var(--pf-border, #F0E6DE);
  --brand: var(--pf-brand, #FF6B35);
  --brand-deep: var(--pf-brand-deep, #E85520);
  --brand-soft: var(--pf-brand-soft, #FFF0E8);
  --blue: var(--pf-blue, #3B729E);
  --blue-soft: var(--pf-blue-bg, #EBF3FA);
  --green: var(--pf-success, #2E7D32);
  --green-soft: var(--pf-success-bg, #E8F5E9);
  --red: var(--pf-danger, #C62828);
  --red-soft: var(--pf-danger-bg, #FFEBEE);
  --amber: var(--pf-warning, #E65100);
  --amber-soft: var(--pf-warning-bg, #FFF3E0);
  --purple: var(--pf-info, #37474F);
  --purple-soft: var(--pf-info-bg, #F0F4F8);

  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.staff-page view,
.staff-page text,
.staff-page input,
.staff-page textarea,
.staff-page button,
.staff-page image,
.staff-page canvas {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

/* ---------- 页面容器 ---------- */
.staff-page .content {
  padding: 24rpx 28rpx 0;
}

.staff-page.with-tabbar {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.staff-page.has-foot .content {
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

/* 关联订单上下文条：一条轻量信息，不占卡片位 */
.staff-page .data-strip {
  display: block;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--pf-ink-3, #7A7269);
  background: var(--pf-surface-high, #F5EBE1);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 卡片 ---------- */
.staff-page .card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04), 0 4rpx 12rpx -2rpx rgba(92, 60, 30, 0.02);
}

.staff-page .card.pad-sm { padding: 22rpx; }
.staff-page .card.flat { margin-bottom: 12rpx; }
.staff-page .card.plain { background: var(--pf-surface-low, #FAF2EC); box-shadow: none; }

.staff-page .card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.staff-page .card-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.staff-page .card-sub {
  font-size: 21rpx;
  color: var(--muted);
  font-weight: 400;
}

.staff-page .divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* ---------- 区块标题 ---------- */
.staff-page .section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 32rpx 6rpx 16rpx;
}

.staff-page .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.3rpx;
}

.staff-page .section-extra {
  font-size: 21rpx;
  color: var(--muted);
  font-weight: 400;
}

/* ---------- 身份 / 宠物头图 ---------- */
.staff-page .hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04), 0 4rpx 12rpx -2rpx rgba(92, 60, 30, 0.02);
}

.staff-page .hero .grow { min-width: 0; }

.staff-page .hero-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.staff-page .hero-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
  line-height: 1.5;
}

.staff-page .hero-side {
  flex: none;
  text-align: right;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* ---------- 列表行 ---------- */
.staff-page .kv {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.staff-page .kv .k {
  color: var(--muted);
  flex: none;
  max-width: 54%;
  font-size: 25rpx;
}

.staff-page .kv .v {
  flex: 1;
  text-align: right;
  color: var(--ink);
  font-weight: 500;
  word-break: break-all;
}

.staff-page .kv .v.ok { color: var(--green); }
.staff-page .kv .v.bad { color: var(--red); }
.staff-page .kv .v.ro { color: var(--pf-ink-3, #7A7269); font-weight: 400; }

.staff-page .menu-list { padding: 0 4rpx; }

.staff-page .menu-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 4rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 27rpx;
}

.staff-page .menu-row:last-child { border-bottom: none; }
.staff-page .menu-label { flex: 1; min-width: 0; }
.staff-page .menu-chev { color: var(--pf-border, #F0E6DE); font-size: 30rpx; line-height: 1; }

/* ---------- 布局工具 ---------- */
.staff-page .row {
  display: flex;
  align-items: center;
}

.staff-page .row.between { justify-content: space-between; }
.staff-page .row.top { align-items: flex-start; }
.staff-page .col { display: flex; flex-direction: column; }
.staff-page .grow { flex: 1; min-width: 0; }

.staff-page .gap4 { gap: 8rpx; }
.staff-page .gap6 { gap: 12rpx; }
.staff-page .gap8 { gap: 16rpx; }
.staff-page .gap10 { gap: 20rpx; }
.staff-page .gap12 { gap: 24rpx; }

.staff-page .mt4 { margin-top: 8rpx; }
.staff-page .mt8 { margin-top: 16rpx; }
.staff-page .mt10 { margin-top: 20rpx; }
.staff-page .mt12 { margin-top: 24rpx; }
.staff-page .mt16 { margin-top: 32rpx; }
.staff-page .mb8 { margin-bottom: 16rpx; }
.staff-page .mb12 { margin-bottom: 24rpx; }

/* ---------- 文本 ---------- */
.staff-page .t11 { font-size: 21rpx; }
.staff-page .t12 { font-size: 23rpx; }
.staff-page .t13 { font-size: 25rpx; }
.staff-page .t14 { font-size: 27rpx; }
.staff-page .t15 { font-size: 30rpx; }
.staff-page .t16 { font-size: 32rpx; }
.staff-page .t18 { font-size: 36rpx; }

.staff-page .muted { color: var(--muted); }
.staff-page .strong { font-weight: 600; }
.staff-page .bold { font-weight: 700; }
.staff-page .orange { color: var(--brand); }
.staff-page .blue { color: var(--blue); }
.staff-page .red { color: var(--red); }
.staff-page .green { color: var(--green); }
.staff-page .nowrap { white-space: nowrap; }
.staff-page .right { text-align: right; }
.staff-page .center { text-align: center; }
.staff-page .ell { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- 进度 ---------- */
.staff-page .meter {
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--pf-border, #F0E6DE);
  overflow: hidden;
  margin: 6rpx 0 12rpx;
}

.staff-page .meter-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #F08A52, var(--brand));
  transition: width 0.3s;
}

.staff-page .big-num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1rpx;
}

.staff-page .big-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
  letter-spacing: 0;
  margin-left: 4rpx;
}

/* ---------- 头像 ---------- */
.staff-page .avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex: none;
  overflow: hidden;
  letter-spacing: 0;
}

.staff-page .avatar.lg { width: 96rpx; height: 96rpx; font-size: 32rpx; }
.staff-page .avatar.sm { width: 64rpx; height: 64rpx; font-size: 24rpx; }

.staff-page .a1 { background: #F8E3D4; color: #B4602F; }
.staff-page .a2 { background: #E4EDF8; color: #4A76B8; }
.staff-page .a3 { background: #E4F0E3; color: #4C8A4E; }
.staff-page .a4 { background: #EFE6F5; color: #8A63A8; }
.staff-page .a5 { background: #F7EEDB; color: #A5822C; }
.staff-page .a6 { background: #DDEDEB; color: #3E8279; }

/* ---------- 标签 ---------- */
.staff-page .tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--pf-r-pill, 999rpx);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  vertical-align: middle;
}

.staff-page .tag-orange { background: var(--brand-soft); color: var(--brand); }
.staff-page .tag-blue { background: var(--blue-soft); color: var(--blue); }
.staff-page .tag-green { background: var(--green-soft); color: var(--green); }
.staff-page .tag-red { background: var(--red-soft); color: var(--red); }
.staff-page .tag-gray { background: var(--pf-info-bg, #F0F4F8); color: var(--pf-info, #37474F); }
.staff-page .tag-outline { background: #fff; border: 1rpx solid var(--line); color: var(--muted); }

.staff-page .req-mark {
  color: var(--brand);
  font-size: 21rpx;
  font-weight: 500;
}

/* ---------- 按钮 ---------- */
.staff-page .btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 96rpx;
  width: 100%;
  margin: 0;
  padding: 0 32rpx;
  border: none;
  border-radius: var(--pf-r-pill, 999rpx);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--ink);
  background: var(--pf-border, #F0E6DE);
  font-family: inherit;
}

.staff-page .btn::after { border: none; }
.staff-page .btn.button-hover { opacity: 0.86; }

.staff-page .btn-primary {
  background: linear-gradient(135deg, #FF6B35 0%, #F25C22 100%);
  color: #fff;
  box-shadow: var(--pf-shadow-brand, 0 12rpx 32rpx -4rpx rgba(255, 107, 53, 0.35));
}

.staff-page .btn-secondary {
  background: #fff;
  color: var(--brand);
  border: 1rpx solid var(--brand);
}

.staff-page .btn-outline {
  background: #fff;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
}

.staff-page .btn-red { background: var(--red); color: #fff; }

.staff-page .btn-red-outline {
  background: #fff;
  color: var(--red);
  border: 1rpx solid #EFCFCB;
}

.staff-page .btn-gray { background: #EDE9E3; color: #ADA59B; }

.staff-page .btn[disabled],
.staff-page .btn.btn-disabled {
  background: #E9E3DB;
  color: #B4ACA2;
  box-shadow: none;
}

.staff-page .btn-sm {
  width: auto;
  height: 64rpx;
  padding: 0 26rpx;
  font-size: 24rpx;
  flex: none;
}

.staff-page .btn-xs {
  width: auto;
  height: 54rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex: none;
}

.staff-page .btn-stack { display: flex; gap: 16rpx; }
.staff-page .btn-stack .btn { flex: 1; }

/* ---------- 分段控件 ---------- */
.staff-page .segment {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  background: #EDE7DF;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.staff-page .segment-item {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #7C736A;
  transition: background 0.18s, color 0.18s;
  white-space: nowrap;
}

.staff-page .segment-item.active {
  background: #fff;
  color: var(--brand);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(90, 64, 44, 0.1);
}

/* ---------- 表单 ---------- */
.staff-page .form-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.staff-page .form-row:last-child { border-bottom: none; }

.staff-page .form-label {
  width: 168rpx;
  flex: none;
  font-size: 26rpx;
  color: var(--ink-2);
  padding-top: 24rpx;
  line-height: 1.4;
}

.staff-page .form-label.req::before {
  content: "*";
  color: var(--brand);
  margin-right: 6rpx;
}

.staff-page .form-label.ro { color: var(--muted); }
.staff-page .form-field { flex: 1; min-width: 0; }

.staff-page .input {
  width: 100%;
  height: 80rpx;
  padding: 0 22rpx;
  background: var(--pf-surface-low, #FAF2EC);
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
  font-family: inherit;
}

.staff-page .textarea {
  width: 100%;
  min-height: 156rpx;
  padding: 20rpx 22rpx;
  background: var(--pf-surface-low, #FAF2EC);
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
  font-family: inherit;
}

.staff-page .select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  background: #F5F0EA;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--pf-ink-3, #7A7269);
}

.staff-page .inline-input { display: flex; align-items: center; gap: 12rpx; }

.staff-page .inline-input .input { flex: 1; width: auto; }
.staff-page .unit { font-size: 24rpx; color: var(--muted); flex: none; }

.staff-page .hint {
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 10rpx;
}

.staff-page .ro-value { font-size: 26rpx; padding-top: 24rpx; color: var(--pf-ink-3, #7A7269); }

/* ---------- 单选 / 多选 ---------- */
.staff-page .choice-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-top: 4rpx;
}

.staff-page .choice {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--pf-border, #F0E6DE);
  border-radius: 999rpx;
  background: #fff;
  font-size: 25rpx;
  color: var(--ink-2);
  white-space: nowrap;
}

.staff-page .choice.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.staff-page .choice-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.staff-page .choice-grid.c4 { grid-template-columns: repeat(4, 1fr); }

.staff-page .choice-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 12rpx;
  border: 1rpx solid var(--pf-border, #F0E6DE);
  border-radius: 16rpx;
  background: #fff;
  font-size: 26rpx;
  color: var(--ink-2);
  text-align: center;
}

.staff-page .choice-card.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.staff-page .check-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 4rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.staff-page .check-row:last-child { border-bottom: none; }

.staff-page .check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D3C9BD;
  background: #fff;
  flex: none;
  position: relative;
}

.staff-page .check-row.on .check-box {
  background: var(--brand);
  border-color: var(--brand);
}

.staff-page .check-row.on .check-box::after {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 7rpx;
  width: 10rpx;
  height: 18rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(42deg);
}

.staff-page .check-row.on { color: var(--brand); font-weight: 600; }

/* 原生 switch：只做尺寸收敛 */
.staff-page .switch {
  transform: scale(0.82);
  transform-origin: right center;
  flex: none;
}

/* ---------- 照片 ---------- */
.staff-page .photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 4rpx;
}

.staff-page .photo {
  position: relative;
  width: 100%;
  height: 190rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F2EDE6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.staff-page .photo.filled { background: linear-gradient(135deg, #E9DED0, #D6C7B5); }

.staff-page .photo.filled::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.5), transparent 62%);
}

.staff-page .photo-mark { position: relative; font-size: 34rpx; color: var(--pf-ink-4, #A8A096); opacity: 0.7; }

.staff-page .photo-add {
  border: 2rpx dashed var(--pf-border, #F0E6DE);
  background: var(--pf-surface-low, #FAF2EC);
  color: #A79D91;
  flex-direction: column;
  gap: 6rpx;
}

.staff-page .photo-add text { font-size: 21rpx; }
.staff-page .photo-add .ico { font-size: 34rpx; line-height: 1; }

.staff-page .photo-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.staff-page .photo-wm {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 24, 20, 0.56);
  color: #fff;
  font-size: 16rpx;
  line-height: 1.5;
  text-align: center;
  padding: 4rpx 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  z-index: 2;
}

.staff-page .photo-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(28, 24, 20, 0.45);
  color: #fff;
  font-size: 18rpx;
  line-height: 1.5;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  z-index: 2;
}

.staff-page .photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(28, 24, 20, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  z-index: 2;
}

.staff-page .photo-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}

/* ---------- 手写签名 ---------- */
.staff-page .sign-pad {
  position: relative;
  height: 280rpx;
  border: 2rpx dashed var(--pf-border, #F0E6DE);
  border-radius: 20rpx;
  background: var(--pf-surface-low, #FAF2EC);
  overflow: hidden;
}

.staff-page .sign-canvas {
  width: 100%;
  height: 100%;
  display: block;
  touch-action: none;
}

.staff-page .sign-ph {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pf-ink-4, #A8A096);
  font-size: 24rpx;
}

.staff-page .sign-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 16rpx;
}

.staff-page .sign-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 16rpx;
}

.staff-page .sign-wrap { width: 100%; }

/* ---------- 提示条 ---------- */
.staff-page .notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  font-size: 23rpx;
  line-height: 1.65;
}

.staff-page .notice .ico {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.65;
}

.staff-page .notice-warn { background: var(--amber-soft); color: #96601B; }
.staff-page .notice-danger { background: var(--red-soft); color: #A33A31; }
.staff-page .notice-info { background: var(--blue-soft); color: #3D6CA5; }
.staff-page .notice-success { background: var(--green-soft); color: #2F7A4B; }

.staff-page .notice-title {
  font-weight: 600;
  margin-bottom: 2rpx;
  font-size: 24rpx;
}

.staff-page .notice .btn { margin-top: 16rpx; height: 64rpx; font-size: 24rpx; width: auto; }

/* ---------- 数据 ---------- */
.staff-page .stat-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.staff-page .stat-grid .stat { flex: 1; }

.staff-page .stat-grid.c4 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}

.staff-page .stat {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 28rpx 12rpx;
  text-align: center;
  position: relative;
  box-shadow: var(--pf-shadow-card, 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04));
}

.staff-page .stat-num {
  font-size: 56rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.staff-page .stat-label {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 6rpx;
  line-height: 1.4;
}

.staff-page .stat-badge {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: var(--red);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* 首页岗位概览 */
.staff-page .hero-card {
  background: var(--card);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04), 0 4rpx 12rpx -2rpx rgba(92, 60, 30, 0.02);
}

.staff-page .hero-title { font-size: 23rpx; color: var(--muted); }
.staff-page .hero-num {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1rpx;
  margin: 4rpx 0 22rpx;
  color: var(--ink);
}

.staff-page .hero-num .hero-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
  margin-left: 8rpx;
  letter-spacing: 0;
}

.staff-page .hero-stats {
  display: flex;
  border-top: 1rpx solid var(--line);
  padding-top: 22rpx;
}

.staff-page .hero-stats > view { flex: 1; text-align: center; }
.staff-page .hero-stats .hero-b {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.staff-page .hero-stats text {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

/* 巡视进度 */
.staff-page .ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  position: relative;
  flex: none;
  background: conic-gradient(var(--brand) 0 6%, var(--pf-border, #F0E6DE) 6% 100%);
}

.staff-page .ring-track {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  border-radius: 50%;
  background: var(--card);
}

.staff-page .ring-center {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.staff-page .ring-center .bold { font-size: 38rpx; color: var(--ink); line-height: 1.2; }
.staff-page .ring-center text { font-size: 21rpx; color: var(--muted); margin-top: 2rpx; }

.staff-page .mini-counts {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.staff-page .mini-count { flex: 1; text-align: center; }
.staff-page .mini-count text { display: block; font-size: 30rpx; font-weight: 700; line-height: 1.3; }
.staff-page .mini-count text + text { font-size: 21rpx; font-weight: 400; color: var(--muted); }

/* ---------- 任务卡 ---------- */
.staff-page .task {
  background: var(--card);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(90, 64, 44, 0.04);
}

.staff-page .task.done { opacity: 0.72; }
.staff-page .task.locked { filter: grayscale(1); opacity: 0.5; }
.staff-page .task.alert { background: #FFF8F6; box-shadow: inset 0 0 0 1rpx #F6DDD8; }

.staff-page .task-head { display: flex; align-items: center; gap: 20rpx; }

.staff-page .task-name {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
}

.staff-page .task-meta {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 4rpx;
  line-height: 1.55;
}

.staff-page .task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.staff-page .task-time {
  font-size: 22rpx;
  color: var(--muted);
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

/* ---------- 时间线 ---------- */
.staff-page .timeline { position: relative; padding-left: 30rpx; }

.staff-page .timeline::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 28rpx;
  bottom: 28rpx;
  width: 2rpx;
  background: #E3DED6;
}

.staff-page .tl-item { position: relative; margin-bottom: 16rpx; }

.staff-page .tl-dot {
  position: absolute;
  left: -30rpx;
  top: 36rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--brand);
  border: 4rpx solid var(--bg);
  z-index: 1;
}

.staff-page .tl-dot.blue { background: var(--blue); }
.staff-page .tl-dot.gray { background: #C9C3BA; }

.staff-page .tl-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(90, 64, 44, 0.04);
}

.staff-page .tl-card.finished { opacity: 0.66; }

/* 定位 / 路线信息块（不使用假地图） */
.staff-page .map-box {
  position: relative;
  min-height: 132rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F2F6F1, #E8EFE7);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.staff-page .map-label {
  font-size: 22rpx;
  color: #6B7A6B;
}

.staff-page .map-tag {
  font-size: 26rpx;
  font-weight: 600;
  color: #41523F;
}

/* ---------- 底部固定操作栏 ---------- */
.staff-page .footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -8rpx 32rpx -12rpx rgba(92, 60, 30, 0.08);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}

.staff-page .footer .btn-stack { margin-bottom: 0; }

.staff-page .footer-hint {
  font-size: 21rpx;
  color: var(--muted);
  text-align: center;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

/* ---------- 成功态 ---------- */
.staff-page .success {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 96rpx 48rpx  48rpx;
  text-align: center;
}

.staff-page .success.show { display: flex; }

.staff-page .success-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--green-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

.staff-page .success-icon::after {
  content: "";
  width: 34rpx;
  height: 62rpx;
  border: solid var(--green);
  border-width: 0 6rpx 6rpx 0;
  transform: rotate(42deg);
  margin-top: -14rpx;
}

.staff-page .success-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.staff-page .success-desc {
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.7;
  max-width: 520rpx;
  margin-bottom: 44rpx;
}

.staff-page .success .btn {
  max-width: 440rpx;
  margin: 0 auto;
  height: 84rpx;
  font-size: 27rpx;
}

/* ---------- 空态 ---------- */
.staff-page .empty {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  padding: 64rpx 0;
}

/* ---------- 首页专用 ---------- */
.staff-page .home-profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card);
  border-radius: var(--pf-r-card, 40rpx);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(92, 60, 30, 0.04), 0 4rpx 12rpx -2rpx rgba(92, 60, 30, 0.02);
}

.staff-page .home-stat {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.staff-page .home-stat .stat {
  flex: 1;
  background: transparent;
  box-shadow: none;
  padding: 0;
}

.staff-page .home-stat .stat-num { font-size: 40rpx; }
.staff-page .home-stat .stat-label { margin-top: 4rpx; }

/* 工作台入口（两列宫格） */
.staff-page .workbench-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.staff-page .workbench {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(90, 64, 44, 0.04);
}

.staff-page .workbench .avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.staff-page .workbench-title {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.staff-page .workbench-sub {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

.staff-page .workbench-arrow {
  color: var(--pf-border, #F0E6DE);
  font-size: 26rpx;
  flex: none;
}

/* 岗位职责只读提示 */
.staff-page .duty-list.off .task,
.staff-page .duty-list.off .stat {
  filter: grayscale(1);
  opacity: 0.45;
}

.staff-page .duty-list.off { pointer-events: none; }

.staff-page .ico { display: inline-block; flex: none; vertical-align: middle; }

/* 页脚说明（非交互） */
.staff-page .foot-note {
  font-size: 21rpx;
  color: #ADA398;
  line-height: 1.6;
  text-align: center;
  padding: 28rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

/* 作业页统一主语头：订单号退到上下文，不再占首屏 */
.staff-page .subject-bar {
  display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx;
  padding: 8rpx 4rpx 20rpx;
}
.staff-page .subject-name { font-size: 34rpx; font-weight: 700; color: var(--text); }
.staff-page .subject-room, .staff-page .subject-round { font-size: 24rpx; color: var(--text); }
.staff-page .subject-sep { color: var(--sub); }
.staff-page .subject-context { font-size: 22rpx; color: var(--sub); padding: 0 4rpx 16rpx; }
