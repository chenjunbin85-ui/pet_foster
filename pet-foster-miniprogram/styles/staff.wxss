/* ---- 小程序适配补丁 ---- */
.staff-page{width:100%;min-height:100vh;background:var(--bg);display:flex;flex-direction:column;position:relative;box-sizing:border-box}
.staff-page button::after{border:none}
.staff-page .topbar{position:sticky;top:0;z-index:10;background:var(--bg);flex:none}
.staff-page .content{flex:1;box-sizing:border-box}
.staff-page .footer{position:sticky;bottom:0;z-index:8;background:#fff;border-top:1rpx solid var(--line)}
.staff-page .ring{width:224rpx;height:224rpx;border-radius:50%;position:relative;flex:none;
  background:conic-gradient(#E8743B 0 33%,#F2EEE8 33% 100%)}
.staff-page .ring-track{position:absolute;top:20rpx;right:20rpx;bottom:20rpx;left:20rpx;border-radius:50%;background:var(--card)}
.staff-page .ring-center{position:absolute;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;z-index:1}
.staff-page .ring-center text{font-size:22rpx;color:var(--sub)}
.staff-page .ring-center .bold{font-size:40rpx;color:var(--text)}
.staff-page .photo-img{position:absolute;top:0;left:0;width:100%;height:100%}
.staff-page .sign-canvas{width:100%;height:100%;display:block}
.staff-page .sign-wrap{width:100%}
.staff-page .data-strip{font-size:22rpx;color:#8A847C;background:#FBF8F4;
  border:1rpx solid var(--line);border-radius:12rpx;padding:12rpx 16rpx;margin-bottom:16rpx}
.staff-page .empty{text-align:center;color:var(--sub);font-size:24rpx;padding:48rpx 0}
.staff-page .duty-list.off .task,.staff-page .duty-list.off .stat{filter:grayscale(1);opacity:.45}
.staff-page .duty-list.off{pointer-events:none}
.staff-page .row.gap6{gap:12rpx}
.staff-page .hero-unit{font-size:26rpx;font-weight:500;margin-left:8rpx}
.staff-page .hero-b{display:block;font-size:32rpx;font-weight:700}
.staff-page .home-profile{margin-bottom:24rpx}
.staff-page .menu-list{padding:0 24rpx}
.staff-page .menu-row{display:flex;align-items:center;gap:12rpx;padding:24rpx 0;
  border-bottom:1rpx solid var(--line);font-size:26rpx}
.staff-page .menu-row:last-child{border-bottom:none}
.staff-page .menu-label{flex:1}
.staff-page .menu-chev{color:#C3BCB2;font-size:32rpx}
.staff-page .home-stat{display:flex;gap:16rpx}
.staff-page .home-stat .stat{flex:1;margin:0}
